{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRamble",
  "version": "0.24.0",
  "identifier": "is.waiwai.dictation",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "OpenRamble",
        "width": 760,
        "height": 620,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "../../macos/OpenRamble/Resources/AppIcon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Local dictation",
    "longDescription": "Hold a key, speak, release it, and the text appears in whatever you were typing in. Recognition runs on this machine.",
    "macOS": {
      "frameworks": ["Sparkle.framework"],
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "bundleVersion": "50"
    }
  }
}
