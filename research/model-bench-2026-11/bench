    "fable": ("claude", "claude-fable-5-2"),
    "opus": ("claude", "claude-opus-5-5"),
    "sonnet": ("claude", "claude-sonnet-5-5"),
    "haiku": ("claude", "claude-haiku-5-5"),
    "gpt": ("codex", "gpt-6.2-sol"),
}
PILOT_TASKS = ["r39-clipboard-gate", "t-exists", "r97-handsfree-stop", "r88-conjunction"]
# Haiku is the floor: a benchmark that cannot tell it from the others measures nothing.
PILOT_MODELS = ["fable", "sonnet", "gpt", "haiku"]
EFFORT = os.environ.get("BENCH_EFFORT", "high")
# The judge that marks slop is not one of the models it marks. Pairs are also
