        meta, grade = json.loads((path.parent / "meta.json").read_text()), json.loads(path.read_text())
        if grade["state"] == "void":
            continue
        size = grade.get("size") or {}
        used.add(key_of[meta["model"]])
        by_task.setdefault(meta["task"], []).append({
            "model": key_of[meta["model"]], "state": grade["state"], "reason": grade.get("reason", ""),
            "minutes": round(meta["seconds"] / 60, 1), "cost": meta["cost_usd"], "tokens": meta["tokens"],
