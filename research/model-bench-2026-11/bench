def opening(text, limit=300):
    """The first sentences of what a model wrote, as plain text."""
    plain = " ".join(re.sub(r"[*_`#>|]", "", text).split())
    if len(plain) <= limit:
        return plain
    cut = plain[:limit]
    end = max(cut.rfind(". "), cut.rfind("? "), cut.rfind("! "))
    return cut[:end + 1] if end > limit // 2 else cut.rsplit(" ", 1)[0] + " ..."


def site():
    """results/index.html: the same numbers as REPORT.md, as a page to look at."""
    key_of = {model: key for key, (_, model) in MODELS.items()}
    data = {"date": time.strftime("%-d %B %Y"), "effort": EFFORT, "replay": {"tasks": []}}
