# private instructions, so both stay outside the repository.
WORK = Path(os.environ.get("BENCH_WORK", HOME / ".openramble/model-bench"))
RESULTS = HERE / "results"
OWNER_INSTRUCTIONS = Path(os.environ.get("BENCH_OWNER_INSTRUCTIONS", HOME / ".claude/CLAUDE.md"))
RUN_TIMEOUT = int(os.environ.get("BENCH_RUN_TIMEOUT", 3600))

