NAMES = {"fable": "Fable 5.2", "opus": "Opus 5.5", "sonnet": "Sonnet 5.5", "haiku": "Haiku 5.5", "gpt": "GPT-6.2 Sol",
         "astra": "GPT-6.2 Astra"}


def lines_written(patch):
    """The lines of code and of tests that a change adds, file by file, each
    as its indent and its length. Blank lines, fixtures and data are left out."""
    files, current = [], None
    for raw in patch.decode("utf-8", "replace").splitlines():
        if raw.startswith("diff --git "):
            path = raw.split(" b/", 1)[1]
            kind = ("fixtures" if FIXTURE.search(path) else "tests" if TEST_FILE.search(path)
                    else "source" if SOURCE_FILE.search(path) else "other")
            current = {"kind": kind, "lines": []}
            files.append(current)
        elif current and raw.startswith("+") and not raw.startswith("+++") and raw[1:].strip():
            text = raw[1:].expandtabs(4)
            current["lines"].append([min(len(text) - len(text.lstrip()), 60), min(len(text.strip()), 100)])
    files = [f for f in files if f["kind"] in ("source", "tests") and f["lines"]]
    return {"files": sorted(files, key=lambda f: f["kind"]),
            **{kind: sum(len(f["lines"]) for f in files if f["kind"] == kind) for kind in ("source", "tests")}}


def geometric_mean(ratios):
    """The mean for "times as much": 4 times and a quarter average to 1."""
    ratios = [r for r in ratios if r and r > 0]
    product = 1.0
    for r in ratios:
        product *= r
    return round(product ** (1 / len(ratios)), 2) if ratios else None


def results():
    """Everything the report and the page show, read from the result files:
    what was needed beside what each model made."""
    key_of = {model: key for key, (_, model) in MODELS.items()}
    data = {"date": time.strftime("%-d %B %Y"), "effort": EFFORT, "replay": [], "slop": [], "board": {}}
    runs = {}
    for path in sorted((RESULTS / "replay").glob("*/grade.json")):
        meta, grade = json.loads((path.parent / "meta.json").read_text()), json.loads(path.read_text())
        wrote = lines_written((path.parent / "change.patch").read_bytes())
        notes = [note for note, on in (
            ("said done when the checks say no", grade.get("false_green")),
            ("said done, and a check it could not run says no", grade.get("unseen_denied")),
            ("said checks passed and ran none", grade.get("unproven_claim")),
            ("its own tests pass on the unfixed code", (grade.get("own_tests") or {}).get("fail_on_base") is False),
            (f"added files nobody asked for: {', '.join(grade.get('unasked_files', []))}", grade.get("unasked_files")),
            ("looked outside its folder", meta["outside_reads"]),
            (f"ran {meta['network_calls']} network commands", meta["network_calls"]),
            (f"the Mac slept {meta.get('slept_seconds', 0) // 60} minutes during the run", meta.get("slept_seconds", 0) > 60)) if on]
        runs.setdefault(meta["task"], {})[key_of[meta["model"]]] = {
            "state": grade["state"], "reason": grade.get("reason", ""), "minutes": round(meta["seconds"] / 60, 1),
            "cost": meta["cost_usd"], "tokens": meta["tokens"], "load": meta["load_before"], "notes": notes,
            "source": wrote["source"], "tests": wrote["tests"], "files": wrote["files"],
            "report": (path.parent / "final.md").read_text().strip()}
    for name in sorted(runs, key=lambda t: (PILOT_TASKS + [t]).index(t)):
        task = Task(name)
        shipped = lines_written(task.reference_patch())
        data["replay"].append({"id": name, "title": task.title, "request": task.request, "note": getattr(task, "note", None),
                               "shipped": {"source": shipped["source"], "files": shipped["files"]}, "runs": runs[name]})

    scores_path = RESULTS / "slop/scores.json"
    scores = json.loads(scores_path.read_text())["outputs"] if scores_path.exists() else []
    answers = {}
    for row in scores:
        text = json.loads((RESULTS / "slop/outputs" / f"{row['item']}.{row['condition']}.{row['model']}.json").read_text())["output"]
        answers.setdefault(row["item"], {}).setdefault(row["model"], {})[row["condition"]] = {
            "text": text, "words": row["words"], "missing": row["missing"]}
    for item in slop_items():
        data["slop"].append({"id": item["id"], "situation": item["situation"], "ask": item["ask"], "label": item["label"],
                             "needed": {"text": item["reference"], "words": len(item["reference"].split())},
                             "answers": answers.get(item["id"], {})})

    used = [key for key in MODELS if any(key in r for r in runs.values()) or any(key in a for a in answers.values())]
    for key in used:
        graded = [(t, t["runs"][key]) for t in data["replay"] if key in t["runs"] and t["runs"][key]["state"] != "void"]
        # A small change that is not right is not a tidy one, so lines of code
        # are counted only on the changes a model got right.
        right = [(t, r) for t, r in graded if r["state"] == "pass" and t["shipped"]["source"]]
        times = lambda condition: geometric_mean([job["answers"][key][condition]["words"] / job["needed"]["words"]
                                                 for job in data["slop"] if condition in job["answers"].get(key, {})])
        data["board"][key] = {
            "passed": [sum(1 for _, r in graded if r["state"] == "pass"), len(graded)],
            "code": geometric_mean([r["source"] / t["shipped"]["source"] for t, r in right]), "code_changes": len(right),
            "words": times("instructed"), "words_plain": times("plain")}
    data["models"] = [{"key": key, "name": NAMES[key], "tool": "in Claude Code" if MODELS[key][0] == "claude" else "in Codex"}
                      for key in used]
    return data


def report():
    """REPORT.md is the page in plain text, with the figures a page would
    crowd: tokens, load, and what the audit noticed."""
    data = results()
    models = data["models"]
    x = lambda v: "n/a" if v is None else f"{v:.0f}×" if v >= 9.95 else f"{v:.1f}×"
    lines = ["# Pilot results", "", f"Written by `bench report` on {time.strftime('%Y-%m-%d %H:%M')}. One run per model "
             "and task, so read each line as \"this happened once\". `index.html` is the same as a page.", "",
             "| Model | Passed | Code, × what shipped | Words, × what was needed | The same without his instructions |",
             "|---|---|---|---|---|"]
    for m in models:
        b = data["board"][m["key"]]
        lines.append(f"| {m['name']} {m['tool']} | {b['passed'][0]} of {b['passed'][1]} | {x(b['code'])} ({b['code_changes']}) | "
                     f"{x(b['words'])} | {x(b['words_plain'])} |")
    lines += ["", "\"Passed\" counts a change that passed the real change's tests and every further check. "
              "\"Code\" is the lines of code a model added, against the lines the real change added, tests left out. "
              "It is counted on the changes a model got right, whose number is in brackets, "
              "because a small change that is not right is not a tidy one. "
              "\"Words\" is the words a model wrote, against what shipped or, for a question, the short right answer. "
              "Both are geometric means.", "", "## Replay"]
    for t in data["replay"]:
        lines += ["", f"### {t['title']} (`{t['id']}`)", "", f"What shipped: {t['shipped']['source']} lines of code."
                  + (f" {t['note']}" if t["note"] else ""), "",
                  "| Model | Result | Lines of code | Lines of tests | Minutes | Load | Tokens | List price | Noticed |",
                  "|---|---|---|---|---|---|---|---|---|"]
        for m in models:
            r = t["runs"].get(m["key"])
            if not r:
                continue
            if r["state"] == "void":
                lines.append(f"| {m['name']} | void | | | | | | | {r['reason'].split(':')[0]} |")
                continue
            lines.append(f"| {m['name']} | {r['state']}{': ' + r['reason'] if r['reason'] else ''} | {r['source']} | {r['tests']} | "
                         f"{r['minutes']:.1f} | {r['load']} | {r['tokens'] / 1e6:.2f}M | "
                         f"{'$%.2f' % r['cost'] if r['cost'] is not None else 'n/a'} | {'; '.join(r['notes'])} |")
    if data["slop"]:
        lines += ["", "## Slop", "", "Words written, first without Mik's instructions and then with them. A star marks an answer "
                  "that left out a fact the job needed.", "",
                  "| Job | Needed | " + " | ".join(m["name"] for m in models) + " |", "|---|---|" + "---|" * len(models)]
        for job in data["slop"]:
            cells = []
            for m in models:
                a = job["answers"].get(m["key"], {})
                cells.append(" → ".join((f"{a[c]['words']}{'*' if a[c]['missing'] else ''}" if c in a else "none") for c in CONDITIONS))
            lines.append(f"| {job['situation']}: {job['ask'][:60]} | {job['needed']['words']} | " + " | ".join(cells) + " |")
    for path in sorted((RESULTS / "slop").glob("repeat-*.json")):
        rep = json.loads(path.read_text())
        item = next(i for i in slop_items() if i["id"] == rep["item"])
        lines += ["", f"### One job, many times: {item['ask']}", "", f"How often a model {rep['probe']}, with a 95% interval. "
                  f"{len(rep['rows'])} of {rep['asked']} prompts were answered.", "",
                  "| Model | Without his instructions | With them |", "|---|---|---|"]
        for m in models:
            cells = []
            for condition in CONDITIONS:
                mine = [r["yes"] for r in rep["rows"] if r["model"] == m["key"] and r["condition"] == condition]
                low, high = wilson(sum(mine), len(mine))
                cells.append(f"{sum(mine)} of {len(mine)} ({100 * low:.0f}% to {100 * high:.0f}%)")
            lines.append(f"| {m['name']} | " + " | ".join(cells) + " |")
    lines.append("")
    (RESULTS / "REPORT.md").write_text("\n".join(lines))
    page = (HERE / "site/page.html").read_text().replace("/*DATA*/null", json.dumps(data, ensure_ascii=False).replace("</", "<\\/"))
    (RESULTS / "index.html").write_text(page)
    say(f"wrote {RESULTS / 'REPORT.md'} and {RESULTS / 'index.html'}")


def pilot(effort):
    for name in PILOT_TASKS:
        proof = RESULTS / "replay/_tasks" / name
        if not (proof / "check.json").exists() or not json.loads((proof / "check.json").read_text())["usable"]:
            if not replay_check(Task(name)):
                sys.exit(f"{name} is not usable; see {proof}")
        wrong = proof / "wrong.json"
        if (json.loads(wrong.read_text())["state"] == "pass") if wrong.exists() else not replay_wrong(Task(name)):
            sys.exit(f"the grader passed the wrong change for {name}")
    for name in PILOT_TASKS:
        for model in PILOT_MODELS:
            replay_run(Task(name), model, 1, effort)
    for model in PILOT_MODELS:
        slop_run(model, effort)
    slop_score()
    report()


def main():
    # Stopping the harness has to run the cleanup above.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("words", nargs="+")
    parser.add_argument("--rep", type=int, default=1)
    parser.add_argument("--effort", default=EFFORT)
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--seconds", type=float)
    args = parser.parse_args()
    words = args.words
    if words[:2] == ["replay", "check"]:
        sys.exit(0 if all([replay_check(Task(t)) for t in words[2:]]) else 1)
    if words[:2] == ["replay", "wrong"]:
        sys.exit(0 if all([replay_wrong(Task(t)) for t in words[2:]]) else 1)
    if words[:2] == ["replay", "run"] and len(words) == 4:
        replay_run(Task(words[2]), words[3], args.rep, args.effort, args.force)
        return
    if words[:2] == ["replay", "prepare"] and len(words) == 4:
        return replay_prepare(Task(words[2]), words[3])
    if words[:2] == ["replay", "ingest"] and len(words) == 5:
        replay_ingest(Task(words[2]), words[3], words[4], args.effort, args.rep, args.seconds)
        return
    if words[:2] == ["replay", "grade"]:
        for run in words[2:]:
            replay_grade(run)
        return
    if words[:2] == ["slop", "run"]:
        for model in words[2:] or PILOT_MODELS:
            slop_run(model, args.effort)
        return
    if words[:2] == ["slop", "repeat"] and len(words) == 4:
        return slop_repeat(words[2], int(words[3]), args.effort)
    if words == ["slop", "score"]:
        return slop_score()
    if words == ["report"]:
        return report()
    if words == ["pilot"]:
        return pilot(args.effort)
    parser.error("unknown command; see --help")


if __name__ == "__main__":
    main()
