    for name in sorted(by_task, key=lambda t: (PILOT_TASKS + [t]).index(t)):
        task = Task(name)
        shipped = patch_stats(task.reference_patch())["lines"]
        number = re.match(r"#(\d+)", task.source)
        data["replay"]["tasks"].append({
            "id": name, "title": task.title, "area": task.area, "kind": task.kind, "request": task.request,
            "source": getattr(task, "note", None) or (f"Pull request {number.group(1)}" if number else ""),
            "shipped": {"source": shipped["source"], "tests": shipped["tests"]}, "runs": by_task[name]})

    scores = json.loads((RESULTS / "slop/scores.json").read_text())
    rows, pairs = scores["outputs"], json.loads((RESULTS / "slop/pairs.json").read_text())
    used |= {r["model"] for r in rows}
    items = slop_items()
    judges = [JUDGE] + [j for j in PAIR_JUDGES if j != JUDGE]
    marked_words = lambda mine, who: sum((r["slop_share_by_judge"].get(who) or 0) * r["words"] for r in mine)
    totals = {}
    for model in used & {r["model"] for r in rows}:
        totals[model] = {"pairs": {}}
        for condition in CONDITIONS:
            mine = [r for r in rows if r["model"] == model and r["condition"] == condition]
            words = sum(r["words"] for r in mine)
            totals[model][condition] = {"words": round(median([r["words"] for r in mine])),
                                        "share": {who: round(marked_words(mine, who) / max(words, 1), 3) for who in judges}}
        for who in judges:
            played = [pair for pair in pairs if model in (pair["a"], pair["b"]) and pair["picks"].get(who)]
            totals[model]["pairs"][who] = [sum(1 for pair in played if pair["picks"][who] == model), len(played)]
    both = [pair for pair in pairs if all(pair["picks"].get(who) for who in judges)]
    data["slop"] = {
        "items": len(items), "totals": totals,
        "judges": [{"key": who, "name": NAMES[who]} for who in judges],
        "judge_ratio": round(marked_words(rows, judges[1]) / max(marked_words(rows, judges[0]), 1)) if len(judges) > 1 else 1,
        "agree": [sum(1 for pair in both if len(set(pair["picks"].values())) == 1), len(both)],
        "situations": [{"name": situation.capitalize(),
                        "shipped": round(median([len(i["reference"].split()) for i in items if i["situation"] == situation])),
                        "models": {model: [round(median([r["words"] for r in rows if r["model"] == model
                                                         and r["condition"] == c and r["situation"] == situation]))
                                           for c in CONDITIONS] for model in totals}}
                       for situation in SITUATIONS if any(i["situation"] == situation for i in items)],
        "repeat": None}
    for path in sorted((RESULTS / "slop").glob("repeat-*.json"))[:1]:
        rep = json.loads(path.read_text())
        probe = next(i for i in items if i["id"] == rep["item"])["probe"]
        cells = []
        for model in [m for m in MODELS if m in totals]:
            for condition in CONDITIONS:
                answers = sorted((r for r in rep["rows"] if r["model"] == model and r["condition"] == condition),
                                 key=lambda r: r["n"])
                read = lambda r: json.loads((RESULTS / "slop/repeats" / f"{rep['item']}.{condition}.{model}.{r['n']:02d}.json").read_text())["output"]
                cells.append({"model": model, "condition": condition,
                              "answers": [{"yes": r["first_words"], "opening": opening(read(r), 260)} for r in answers]})
        data["slop"]["repeat"] = {**probe["shown"], "cells": cells}
    data["models"] = [{"key": key, "name": NAMES[key], "tool": "in Claude Code" if MODELS[key][0] == "claude" else "in Codex"}
                      for key in MODELS if key in used]
    page = (HERE / "site/page.html").read_text().replace("/*DATA*/null", json.dumps(data, ensure_ascii=False).replace("</", "<\\/"))
    (RESULTS / "index.html").write_text(page)
    say(f"wrote {RESULTS / 'index.html'}")


def pilot(effort):
    for name in PILOT_TASKS:
        proof = RESULTS / "replay/_tasks" / name
        if not (proof / "check.json").exists() or not json.loads((proof / "check.json").read_text())["usable"]:
            if not replay_check(Task(name)):
                sys.exit(f"{name} is not usable; see {proof}")
        wrong = proof / "wrong.json"
        if (json.loads(wrong.read_text())["state"] == "pass") if wrong.exists() else not replay_wrong(Task(name)):
            sys.exit(f"the grader passed the wrong change for {name}")
    for name in PILOT_TASKS:
        for model in PILOT_MODELS:
            replay_run(Task(name), model, 1, effort)
    for model in PILOT_MODELS:
        slop_run(model, effort)
    slop_score()
    report()


def main():
    # Stopping the harness has to run the cleanup above.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("words", nargs="+")
    parser.add_argument("--rep", type=int, default=1)
    parser.add_argument("--effort", default=EFFORT)
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args()
    words = args.words
    if words[:2] == ["replay", "check"]:
        sys.exit(0 if all([replay_check(Task(t)) for t in words[2:]]) else 1)
    if words[:2] == ["replay", "wrong"]:
        sys.exit(0 if all([replay_wrong(Task(t)) for t in words[2:]]) else 1)
    if words[:2] == ["replay", "run"] and len(words) == 4:
        replay_run(Task(words[2]), words[3], args.rep, args.effort, args.force)
        return
    if words[:2] == ["replay", "grade"]:
        for run in words[2:]:
            replay_grade(run)
        return
    if words[:2] == ["slop", "run"]:
        for model in words[2:] or PILOT_MODELS:
            slop_run(model, args.effort)
        return
    if words[:2] == ["slop", "repeat"] and len(words) == 4:
        return slop_repeat(words[2], int(words[3]), args.effort)
    if words == ["slop", "score"]:
        return slop_score()
    if words == ["slop", "vote"]:
        return slop_vote()
    if words == ["report"]:
        return report()
    if words == ["pilot"]:
        return pilot(args.effort)
    parser.error("unknown command; see --help")


if __name__ == "__main__":
    main()
