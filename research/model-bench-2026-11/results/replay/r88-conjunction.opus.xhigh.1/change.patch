--- a/Packages/DictationCore/Tests/DictationCoreTests/CleanVerbatimTests.swift
+++ b/Packages/DictationCore/Tests/DictationCoreTests/CleanVerbatimTests.swift
@@ -807,6 +807,37 @@ final class CleanVerbatimTests: XCTestCase {
         }
     }
 
+    /// A word that joins ("and", "if", "that", "about", "и") is followed by
+    /// what it joins, so a word said again after it is no restart: only the
+    /// hesitation goes, with spoken corrections on or off. A clause begun
+    /// again still collapses. Lost words are the worse failure, so where the
+    /// two readings meet, both copies stay.
+    func testAWordSaidAgainAfterAJoiningWordIsWhatItJoins() {
+        let cases = [
+            ("We shipped it and, um, it works.", "We shipped it and it works."),
+            ("I'll ask Sam and, uh, Sam will know.", "I'll ask Sam and Sam will know."),
+            ("Ship it if, um, it passes review.", "Ship it if it passes review."),
+            ("I told you that, um, you should come.", "I told you that you should come."),
+            ("We talked to them about, um, them joining.", "We talked to them about them joining."),
+            ("Мы сделали это и, э, это работает.", "Мы сделали это и это работает."),
+            ("Это и, э, это работает.", "Это и это работает."),
+            ("Check the server and, um, the server logs.", "Check the server and the server logs."),
+            ("Give the file to, um, the file owner.", "Give the file to the file owner."),
+            // A clause begun again is a restart.
+            ("I think that, um, I think we should wait.", "I think we should wait."),
+            ("Okay, I think that, um, I think we should wait.", "Okay, I think we should wait."),
+            ("So I think that, um, I think we should wait.", "So I think we should wait."),
+            ("Let's meet at, uh, let's meet on Monday.", "Let's meet on Monday."),
+            // A word that cannot end a phrase is begun again, not joined.
+            ("And so, um, and then we left.", "And then we left."),
+        ]
+        for (input, expected) in cases {
+            XCTAssertEqual(CleanVerbatim.clean(input), expected, input)
+            XCTAssertEqual(CleanVerbatim.clean(input, spokenCorrections: false), expected, "corrections off: " + input)
+            XCTAssertEqual(CleanVerbatim.clean(expected), expected, "idempotent: " + input)
+        }
+    }
