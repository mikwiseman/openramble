+    /// "um" between two words that merely begin alike is not a restart: the
+    /// word before it is a conjunction, a complementizer or a preposition that
+    /// the sentence needs ("it and, um, it works"). Only the hesitation goes.
+    func testAHesitationAfterAConnectorDoesNotEatRealWords() {
+        let cases = [
+            ("We shipped it and, um, it works.", "We shipped it and it works."),
+            ("I'll ask Sam and, uh, Sam will know.", "I'll ask Sam and Sam will know."),
+            ("Ship it if, um, it passes review.", "Ship it if it passes review."),
+            ("I told you that, um, you should come.", "I told you that you should come."),
+            ("We talked to them about, um, them joining.", "We talked to them about them joining."),
+            ("Мы сделали это и, э, это работает.", "Мы сделали это и это работает."),
+            ("Ship the thing if, um, the thing passes.", "Ship the thing if the thing passes."),
+        ]
+        for (input, expected) in cases {
+            for corrections in [true, false] {
+                XCTAssertEqual(CleanVerbatim.clean(input, spokenCorrections: corrections), expected, input)
+            }
+        }
+    }
+
+    /// A real restart still collapses when the phrase it takes back opens the
+    /// sentence or a clause.
+    func testARestartAfterAConnectorStillCollapses() {
+        let cases = [
+            ("I think that, um, I think we should wait.", "I think we should wait."),
+            ("Okay, I think that, um, I think we should wait.", "Okay, I think we should wait."),
+            ("Let's meet at, uh, let's meet on Monday.", "Let's meet on Monday."),
+            ("I talked with the, um, with Kowalski's team.", "I talked with Kowalski's team."),
+        ]
+        for (input, expected) in cases {
+            for corrections in [true, false] {
+                XCTAssertEqual(CleanVerbatim.clean(input, spokenCorrections: corrections), expected, input)
+            }
+        }
+    }
