@@ -0,0 +1,47 @@
+#!/bin/bash
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+
+fixture=$(mktemp -d "$PWD/.network-surface-test.XXXXXX")
+trap 'rm -rf "$fixture"' EXIT
+app=apps/macos/OpenRamble
+core=Packages/DictationCore/Sources
+asr=Packages/LocalASR/Sources
+mkdir -p "$fixture"/{scripts,"$app","$core","$asr"}
+cp scripts/check-network-surface.sh "$fixture/scripts/"
+cp apps/macos/project.yml "$fixture/apps/macos/"
+cd "$fixture"
+
+fail() {
+  cat gate.log >&2
+  echo "FAIL: $*" >&2
+  exit 1
+}
+
+expect_rejection() {
+  if ./scripts/check-network-surface.sh >gate.log 2>&1; then
+    fail "gate accepted $1"
+  fi
+  grep -Fq -- "$1" gate.log || fail "missing diagnostic for $1"
+}
+
+echo 'pasteboard.clearContents()' > "$app/Clipboard.swift"
+expect_rejection "$app/Clipboard.swift:1:pasteboard.clearContents()"
+
+cat > "$app/Clipboard.swift" <<'SWIFT'
+    // A plain clearContents() could send dictation to Universal Clipboard.
+    /// Use the host-only option instead of clearContents().
+    pasteboard.prepareForNewContents(with: .currentHostOnly)
+SWIFT
+mkdir -p apps/macos/OpenRambleTests
+echo 'pasteboard.clearContents()' > apps/macos/OpenRambleTests/ClipboardTests.swift
+./scripts/check-network-surface.sh >gate.log || fail "gate rejected the safe fixture"
+
+echo 'let session = URLSession.shared' > "$asr/Transport.swift"
+expect_rejection "$asr/Transport.swift:1:let session = URLSession.shared"
+rm "$asr/Transport.swift"
+
+rmdir "$core"
+expect_rejection "$core"
+
+echo "PASS: unsafe clipboard and network calls rejected, host-only fixture accepted, missing sources rejected"
