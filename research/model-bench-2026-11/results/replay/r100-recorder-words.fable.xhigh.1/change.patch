--- a/Packages/DictationCore/Tests/DictationCoreTests/MeetingSegmentPolicyTests.swift
+++ b/Packages/DictationCore/Tests/DictationCoreTests/MeetingSegmentPolicyTests.swift
@@ -108,4 +108,107 @@ final class MeetingSegmentPolicyTests: XCTestCase {
         XCTAssertGreaterThanOrEqual(cuts[0].startFrame, frames(3_599), "the segment begins just before the word")
         XCTAssertLessThan(cuts[0].frameCount, frames(14))
     }
+
+    // MARK: - The words before a pause
+
+    /// Feed a script of levels, then flush: everything the policy would ever
+    /// hand to the engine for it.
+    private func segments(
+        _ script: [(level: Float, seconds: Double)],
+        channel: MeetingChannel = .microphone,
+        block: Int = 1_600
+    ) -> [MeetingSegmentRef] {
+        var policy = MeetingSegmentPolicy(channel: channel)
+        var out: [MeetingSegmentRef] = []
+        for step in script {
+            var remaining = frames(step.seconds)
+            while remaining > 0 {
+                let count = min(block, remaining)
+                if let segment = policy.observe(peak: step.level, count: count) { out.append(segment) }
+                remaining -= count
+            }
+        }
+        if let tail = policy.flush() { out.append(tail) }
+        return out
+    }
+
+    func testTheWordsBeforeAPauseAreInTheSegmentWhenTheRecordingBeganWithSilence() {
+        // Five seconds before anyone speaks, twelve of speech, then a pause.
+        let all = segments([(quiet, 5), (speech, 12), (quiet, 3)])
+        guard all.count == 1 else { return XCTFail("expected one segment, got \(all.count)") }
+        XCTAssertLessThanOrEqual(all[0].startFrame, frames(5), "the segment begins before the first word")
+        XCTAssertGreaterThanOrEqual(all[0].endFrame, frames(17), "and ends after the last one")
+        XCTAssertLessThan(all[0].endFrame, frames(18), "inside the pause, not after it")
+    }
+
+    func testTheWordsBeforeAPauseAreInTheSegmentAfterALongPauseToo() {
+        let all = segments([(speech, 12), (quiet, 8), (speech, 12), (quiet, 3)])
+        guard all.count == 2 else { return XCTFail("expected two segments, got \(all.count)") }
+        XCTAssertGreaterThanOrEqual(all[0].endFrame, frames(12))
+        XCTAssertLessThanOrEqual(all[1].startFrame, frames(20), "the second begins before its first word")
+        XCTAssertGreaterThanOrEqual(all[1].endFrame, frames(32), "and ends after its last")
+        XCTAssertLessThan(all[1].endFrame, frames(33))
+    }
+
+    /// The property behind both: whatever the silences around it, every frame
+    /// of speech is inside a segment, and segments never overlap. Text is a
+    /// projection of the segments, so a spoken frame outside all of them is a
+    /// word in the file and missing from the transcript.
+    func testEverySpokenFrameIsInsideASegmentWhateverTheSilencesAroundIt() {
+        for block in [1_600, 512] {
+            for lead in [0, 0.5, 1, 1.5, 4, 90] {
+                for first in [3.0, 12, 27] {
+                    for pause in [0.5, 0.8, 1.5, 6, 40] {
+                        for tail in [0, 2.5] {
+                            let script: [(level: Float, seconds: Double)] = [
+                                (quiet, lead), (speech, first), (quiet, pause), (speech, 12), (quiet, tail),
+                            ]
+                            let all = segments(script, block: block)
+                            let label = "lead \(lead) s, speech \(first) s, pause \(pause) s, tail \(tail) s, block \(block)"
+                            for (earlier, later) in zip(all, all.dropFirst()) {
+                                XCTAssertLessThanOrEqual(earlier.endFrame, later.startFrame, "segments overlap: \(label)")
+                            }
+                            var cursor = 0
+                            for step in script {
+                                let range = cursor..<(cursor + frames(step.seconds))
+                                cursor = range.upperBound
+                                guard step.level == speech else { continue }
+                                var covered = range.lowerBound
+                                for segment in all where segment.startFrame <= covered {
+                                    covered = max(covered, segment.endFrame)
+                                }
+                                XCTAssertGreaterThanOrEqual(
+                                    covered, range.upperBound,
+                                    "speech at \(range.lowerBound)..<\(range.upperBound) is not all in a segment: \(label)"
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    // MARK: - A quiet voice on the other side
+
+    func testAQuietVoiceOnTheOtherSideIsSpeech() {
+        // A quarter of the microphone's floor: audible in the file, and until
+        // now silence to the segmenter for as long as the person spoke.
+        let all = segments([(quiet, 3), (0.005, 12), (quiet, 3)], channel: .system)
+        XCTAssertEqual(all.count, 1)
+        XCTAssertLessThanOrEqual(all.first?.startFrame ?? .max, frames(3))
+        XCTAssertGreaterThanOrEqual(all.first?.endFrame ?? 0, frames(15))
+    }
+
+    func testTheSameLevelOnTheMicrophoneIsStillTheRoom() {
+        // What the speakers leak into the microphone at that level must stay
+        // silence there, or the other side comes back as You.
+        XCTAssertEqual(segments([(quiet, 3), (0.005, 12), (quiet, 3)], channel: .microphone), [])
+    }
+
+    func testLineNoiseOnTheOtherSideIsNotSpeech() {
+        var policy = MeetingSegmentPolicy(channel: .system)
+        XCTAssertEqual(feed(&policy, 0.0005, seconds: 120), [])
+        XCTAssertNil(policy.flush())
+    }
 }
