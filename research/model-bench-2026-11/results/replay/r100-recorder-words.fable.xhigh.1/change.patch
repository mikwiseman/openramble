+
+extension MeetingCaptureTests {
+    /// A caller who is quiet in the tap — far under the microphone's speech
+    /// floor, audible in the file — is still the other side speaking. What
+    /// the speakers leak of them into the microphone is still not You: this
+    /// quiet, the other side does not wake the echo gate, and only the
+    /// microphone's own floor keeps the leak out.
+    func testAQuietVoiceOnTheOtherSideIsSegmentedAndItsLeakIsNotYou() async throws {
+        let microphone = ScriptedAudioSource()
+        let system = ScriptedAudioSource()
+        let segments = UncheckedBox<[MeetingSegmentRef]>([])
+        let capture = MeetingCapture(
+            directory: directory,
+            microphone: microphone,
+            systemAudio: system,
+            segmentParameters: .init(speech: SpeechSegmenter.Parameters(minimumSegment: .seconds(2))),
+            onSegment: { segments.value.append($0) },
+            probe: {}
+        )
+        try await capture.start()
+        // A second of nothing, three seconds of the other side peaking at
+        // 0.008 (an RMS of 0.0046, under the gate's 0.005), leaking into the
+        // microphone at half that and 30 ms late.
+        var state: UInt64 = 7
+        let speech: [Float] = (0..<48_000).map { _ in
+            state = state &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
+            return (Float(state >> 40) / Float(1 << 24) * 2 - 1) * 0.008
+        }
+        let echo: [Float] = (0..<48_000).map { $0 < 480 ? 0 : speech[$0 - 480] * 0.5 }
+        for _ in 0..<10 {
+            microphone.deliver(constant(0, 1_600))
+            system.deliver(constant(0, 1_600))
+        }
+        for block in 0..<30 {
+            let range = (block * 1_600)..<((block + 1) * 1_600)
+            microphone.deliver(Array(echo[range]))
+            system.deliver(Array(speech[range]))
+        }
+        for _ in 0..<10 {
+            microphone.deliver(constant(0, 1_600))
+            system.deliver(constant(0, 1_600))
+        }
+        _ = try await capture.stop()
+
+        let all = segments.value
+        XCTAssertEqual(all.map(\.channel), [.system], "the quiet side has a segment, and only on its own channel")
+        guard let segment = all.first else { return }
+        XCTAssertLessThanOrEqual(segment.startFrame, 16_000, "it begins before their first word")
+        XCTAssertGreaterThanOrEqual(segment.endFrame, 64_000, "and ends after their last")
+    }
+
+    /// Silence first, then speech, then a pause. The cut belongs inside the
+    /// pause, so the words before it are in the segment and not left behind
+    /// it, where the start of the next segment would slide past them.
+    func testTheWordsBeforeAPauseReachASegmentWhenTheRecordingBeganWithSilence() async throws {
+        let microphone = ScriptedAudioSource()
+        let segments = UncheckedBox<[MeetingSegmentRef]>([])
+        let capture = MeetingCapture(
+            directory: directory,
+            microphone: microphone,
+            systemAudio: nil,
+            segmentParameters: .init(speech: SpeechSegmenter.Parameters(minimumSegment: .seconds(2))),
+            onSegment: { segments.value.append($0) }
+        )
+        try await capture.start()
+        for _ in 0..<30 { microphone.deliver(constant(0, 1_600)) }
+        for _ in 0..<30 { microphone.deliver(constant(0.5, 1_600)) }
+        for _ in 0..<30 { microphone.deliver(constant(0, 1_600)) }
+        _ = try await capture.stop()
+
+        let all = segments.value
+        XCTAssertEqual(all.count, 1)
+        guard let segment = all.first else { return }
+        XCTAssertLessThanOrEqual(segment.startFrame, 48_000, "it begins before the first word")
+        XCTAssertGreaterThanOrEqual(segment.endFrame, 96_000, "and ends after the last")
+        XCTAssertLessThan(segment.endFrame, 112_000, "inside the pause")
+    }
+}
diff --git a/Packages/DictationCore/Tests/DictationCoreTests/MeetingSegmentPolicyTests.swift b/Packages/DictationCore/Tests/DictationCoreTests/MeetingSegmentPolicyTests.swift
