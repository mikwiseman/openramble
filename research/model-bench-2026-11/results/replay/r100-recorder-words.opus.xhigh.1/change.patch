diff --git a/Packages/DictationCore/Tests/DictationAudioTests/MeetingCaptureTests.swift b/Packages/DictationCore/Tests/DictationAudioTests/MeetingCaptureTests.swift
index e84ed9a..bdcdb58 100644
--- a/Packages/DictationCore/Tests/DictationAudioTests/MeetingCaptureTests.swift
+++ b/Packages/DictationCore/Tests/DictationAudioTests/MeetingCaptureTests.swift
@@ -685,3 +685,79 @@ extension MeetingCaptureTests {
         XCTAssertEqual(segments.value.map(\.channel), [.system], "the leak did not become a You paragraph")
     }
 }
+
+extension MeetingCaptureTests {
+    /// A participant speaking softly: a tenth of a loud voice on the tap,
+    /// under the microphone's floor, audible in the file all the same. It is
+    /// the other side's paragraph; its leak into the microphone is still
+    /// nobody's.
+    func testTheOtherSidesQuietSpeechIsSegmentedAndItsLeakIsNotYou() async throws {
+        let microphone = ScriptedAudioSource()
+        let system = ScriptedAudioSource()
+        let segments = UncheckedBox<[MeetingSegmentRef]>([])
+        let capture = MeetingCapture(
+            directory: directory,
+            microphone: microphone,
+            systemAudio: system,
+            segmentParameters: .init(speech: SpeechSegmenter.Parameters(minimumSegment: .seconds(2))),
+            onSegment: { segments.value.append($0) },
+            probe: {}
+        )
+        try await capture.start()
+        var state: UInt64 = 42
+        let speech: [Float] = (0..<48_000).map { _ in
+            state = state &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
+            return (Float(state >> 40) / Float(1 << 24) * 2 - 1) * 0.01
+        }
+        let echo: [Float] = (0..<48_000).map { $0 < 480 ? 0 : speech[$0 - 480] * 0.5 }
+        for block in 0..<30 {
+            let range = (block * 1_600)..<((block + 1) * 1_600)
+            microphone.deliver(Array(echo[range]))
+            system.deliver(Array(speech[range]))
+        }
+        for _ in 0..<10 {
+            microphone.deliver(constant(0, 1_600))
+            system.deliver(constant(0, 1_600))
+        }
+        _ = try await capture.stop()
+        XCTAssertEqual(segments.value.map(\.channel), [.system], "the other side, once, and not as You")
+        XCTAssertLessThanOrEqual(segments.value.first?.startFrame ?? .max, 0)
+        XCTAssertGreaterThanOrEqual(segments.value.first?.endFrame ?? 0, 48_000, "every word of it")
+    }
+
+    /// The tone that proves the tap alive arrives on the system channel at
+    /// the start of every call. It must prove it, and never be decoded as
+    /// the other side speaking: that would start their first paragraph at
+    /// the tone instead of at their first word.
+    func testTheProbeProvesTheTapWithoutBecomingASegment() async throws {
+        let microphone = ScriptedAudioSource()
+        let system = ScriptedAudioSource()
+        let segments = UncheckedBox<[MeetingSegmentRef]>([])
+        let capture = MeetingCapture(
+            directory: directory,
+            microphone: microphone,
+            systemAudio: system,
+            onSegment: { segments.value.append($0) },
+            probe: {}
+        )
+        try await capture.start()
+        // The probe exactly as it is played: its left channel, 48 kHz to 16.
+        let wav = SystemAudioProbe.wavData()
+        let tone: [Float] = stride(from: 44, to: wav.count - 3, by: 12).map { offset in
+            let raw = UInt16(wav[offset]) | UInt16(wav[offset + 1]) << 8
+            return Float(Int16(bitPattern: raw)) / 32_768
+        }
+        XCTAssertEqual(tone.count, 4_000)
+        microphone.deliver(constant(0, 3_200))
+        system.deliver(constant(0, 3_200))
+        microphone.deliver(constant(0, tone.count))
+        system.deliver(tone)
+        for _ in 0..<120 {
+            microphone.deliver(constant(0, 1_600))
+            system.deliver(constant(0, 1_600))
+        }
+        let summary = try await capture.stop()
+        XCTAssertTrue(summary.systemAudio.everDeliveredAudio, "the tone is evidence the tap hears")
+        XCTAssertEqual(segments.value, [], "and not the other side speaking")
+    }
+}
diff --git a/Packages/DictationCore/Tests/DictationCoreTests/MeetingSegmentPolicyTests.swift b/Packages/DictationCore/Tests/DictationCoreTests/MeetingSegmentPolicyTests.swift
index b815d78..b0f183b 100644
--- a/Packages/DictationCore/Tests/DictationCoreTests/MeetingSegmentPolicyTests.swift
+++ b/Packages/DictationCore/Tests/DictationCoreTests/MeetingSegmentPolicyTests.swift
@@ -108,4 +108,85 @@ final class MeetingSegmentPolicyTests: XCTestCase {
         XCTAssertGreaterThanOrEqual(cuts[0].startFrame, frames(3_599), "the segment begins just before the word")
         XCTAssertLessThan(cuts[0].frameCount, frames(14))
     }
+
+    /// Every stretch of speech lies inside one of the segments.
+    private func assertCovered(
+        _ speech: [(from: Double, to: Double)],
+        by segments: [MeetingSegmentRef],
+        file: StaticString = #filePath,
+        line: UInt = #line
+    ) {
+        for stretch in speech {
+            var frame = frames(stretch.from)
+            while frame < frames(stretch.to) {
+                guard let segment = segments.first(where: { $0.startFrame <= frame && frame < $0.endFrame }) else {
+                    XCTFail("speech at \(Double(frame) / 16_000) s is in no segment", file: file, line: line)
+                    return
+                }
+                frame = segment.endFrame
+            }
+        }
+    }
+
+    /// The start slides under the silence before the first word. The cut
+    /// that follows must still land inside the pause, not a second early
+    /// with the last words left in no segment at all.
+    func testTheLastWordsBeforeAPauseSurviveASilentStart() {
+        var policy = MeetingSegmentPolicy(channel: .microphone)
+        feed(&policy, quiet, seconds: 3)
+        var all = feed(&policy, speech, seconds: 12)
+        all += feed(&policy, quiet, seconds: 3)
+        all += feed(&policy, speech, seconds: 2)
+        if let tail = policy.flush() { all.append(tail) }
+
+        XCTAssertEqual(all.count, 2)
+        XCTAssertGreaterThan(all.first?.endFrame ?? 0, frames(15), "the cut is inside the pause, after the last word")
+        XCTAssertLessThan(all.first?.endFrame ?? 0, frames(18))
+        assertCovered([(3, 15), (18, 20)], by: all)
+    }
+
+    /// A long pause slides the start again. The next pause must cut where
+    /// it is, too — every one of them, however the recording began.
+    func testTheLastWordsBeforeEveryPauseSurviveLongPauses() {
+        var policy = MeetingSegmentPolicy(channel: .microphone)
+        var all: [MeetingSegmentRef] = []
+        var stretches: [(from: Double, to: Double)] = []
+        var clock = 0.0
+        for _ in 0..<4 {
+            all += feed(&policy, quiet, seconds: 4)
+            clock += 4
+            all += feed(&policy, speech, seconds: 12)
+            stretches.append((clock, clock + 12))
+            clock += 12
+        }
+        if let tail = policy.flush() { all.append(tail) }
+
+        XCTAssertEqual(all.count, 4)
+        for (segment, stretch) in zip(all, stretches) {
+            XCTAssertGreaterThanOrEqual(segment.endFrame, frames(stretch.to), "the segment holds its last word")
+            XCTAssertLessThanOrEqual(segment.startFrame, frames(stretch.from), "and its first")
+        }
+        assertCovered(stretches, by: all)
+    }
+
+    /// The tap is the digital signal the Mac plays: no room, no hiss, exact
+    /// zero between words. A participant who speaks softly is far below the
+    /// microphone's floor there and still plainly audible in the file.
+    func testTheOtherSidesQuietSpeechIsSegmented() {
+        var policy = MeetingSegmentPolicy(channel: .system)
+        feed(&policy, quiet, seconds: 2)
+        var all = feed(&policy, 0.005, seconds: 12)
+        all += feed(&policy, quiet, seconds: 1)
+        XCTAssertEqual(all.count, 1, "speech at the quietest level the model was measured to write out")
+        assertCovered([(2, 14)], by: all)
+    }
+
+    /// The same level on the microphone is the room, or the speakers leaking
+    /// into it. Its floor does not move.
+    func testTheMicrophoneKeepsItsOwnFloor() {
+        var policy = MeetingSegmentPolicy(channel: .microphone)
+        XCTAssertEqual(feed(&policy, 0.015, seconds: 12), [])
+        XCTAssertEqual(feed(&policy, quiet, seconds: 1), [])
+        XCTAssertNil(policy.flush(), "below the microphone's floor is not you speaking")
+    }
 }
