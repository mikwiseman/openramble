+    echo "GATE ERROR: grep failed (exit $rc) for pattern: $pattern" >&2
+    exit 2
+  fi
+  [[ -z "$out" ]] && return 0
+  printf '%s\n' "$out" | grep -v '^Binary' | grep -vE ':[0-9]+: *//' || true
+}
