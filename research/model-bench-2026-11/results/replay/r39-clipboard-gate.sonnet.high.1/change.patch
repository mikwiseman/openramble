--- /dev/null
+++ b/scripts/tests/test-network-gate.sh
@@ -0,0 +1,77 @@
+#!/bin/bash
+# Proves scripts/check-network-surface.sh fails when it should, and cannot pass
+# by accident. Runs the real gate against a throwaway tree seeded with violations.
+
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+
+fail_test() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }
+
+new_tree() {  # new_tree NAME -> prints the tree path
+  local t="$WORK/$1"
+  mkdir -p "$t/scripts" "$t/apps/macos/OpenRamble/System" \
+    "$t/Packages/DictationCore/Sources" "$t/Packages/LocalASR/Sources/LocalASR"
+  cp "$ROOT/scripts/check-network-surface.sh" "$t/scripts/"
+  cp "$ROOT/apps/macos/project.yml" "$t/apps/macos/"
+  echo "$t"
+}
+
+expect_pass() {  # expect_pass TREE LABEL
+  "$1/scripts/check-network-surface.sh" >"$WORK/out" 2>&1 \
+    || { cat "$WORK/out" >&2; fail_test "$2: gate rejected a clean tree"; }
+}
+
+expect_fail() {  # expect_fail TREE LABEL
+  if "$1/scripts/check-network-surface.sh" >"$WORK/out" 2>&1; then
+    cat "$WORK/out" >&2; fail_test "$2: gate passed but must fail"
+  fi
+}
+
+APP=apps/macos/OpenRamble/System
+
+# Clean tree, plus things that must NOT trip it: comments, and the allowed files.
+t=$(new_tree clean)
+printf '/// never call clearContents() here\n// URLSession is banned\n' >"$t/$APP/Doc.swift"
+echo 'let s = URLSession.shared' >"$t/$APP/SparkleUpdater.swift"
+echo 'let s = URLSession.shared' >"$t/Packages/LocalASR/Sources/LocalASR/ModelDownloading.swift"
+expect_pass "$t" "clean tree"
+
+# Each seeded violation must fail the gate.
+seed() {  # seed LABEL FILE LINE
+  local t; t=$(new_tree "$1")
+  printf '%s\n' "$3" >"$t/$2"
+  expect_fail "$t" "$1"
+  echo "ok: $1 is caught"
+}
+seed "plain clearContents"      "$APP/Bad.swift" 'NSPasteboard.general.clearContents()'
+seed "declareTypes"             "$APP/Bad.swift" 'pb.declareTypes([.string], owner: nil)'
+seed "URLSession outside allow" "$APP/Bad.swift" 'let s = URLSession.shared'
+seed "Data(contentsOf:)"        "$APP/Bad.swift" 'let d = try Data(contentsOf: url)'
+seed "logged transcript"        "$APP/Bad.swift" 'logger.info("heard \(transcript)")'
+
+# Missing update setting.
+t=$(new_tree no-update-key)
+grep -vF 'SUSendProfileInfo: false' "$ROOT/apps/macos/project.yml" >"$t/apps/macos/project.yml"
+expect_fail "$t" "missing update key"
+echo "ok: missing update key is caught"
+
+# The regression that started this: a broken gate must fail, never pass.
+t=$(new_tree undefined-pattern)
+grep -v '^FORBIDDEN_PASTEBOARD=' "$ROOT/scripts/check-network-surface.sh" >"$t/scripts/check-network-surface.sh"
+chmod +x "$t/scripts/check-network-surface.sh"
+expect_fail "$t" "undefined clipboard pattern"
+echo "ok: an undefined pattern fails the gate"
+
+t=$(new_tree bad-regex)
+sed "s/^FORBIDDEN_PASTEBOARD=.*/FORBIDDEN_PASTEBOARD='clearContents\\\\(|('/" \
+  "$ROOT/scripts/check-network-surface.sh" >"$t/scripts/check-network-surface.sh"
+chmod +x "$t/scripts/check-network-surface.sh"
+expect_fail "$t" "invalid clipboard regex"
+echo "ok: an invalid regex fails the gate"
+
+# The real repository passes.
+"$ROOT/scripts/check-network-surface.sh" >/dev/null || fail_test "real repository fails the gate"
+echo "PASS"
