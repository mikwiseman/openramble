+#!/bin/bash
+# The network gate must fail on the violations it exists to catch. Each case copies
+# the shipping tree into a scratch fixture, seeds one violation, and expects exit 1.
+# A clean copy must pass.
+
+set -euo pipefail
+
+REPOSITORY_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+FIXTURE="$REPOSITORY_ROOT/.build-zero-network/network-gate-fixture"
+SOURCE_FILE="apps/macos/OpenRamble/System/TextInserter.swift"
+
+fail_test() {
+  printf 'FAIL: %s\n' "$1" >&2
+  exit 1
+}
+
+fresh_fixture() {
+  rm -rf "$FIXTURE"
+  mkdir -p "$FIXTURE/scripts" "$FIXTURE/apps/macos" "$FIXTURE/Packages"
+  cp "$REPOSITORY_ROOT/scripts/check-network-surface.sh" "$FIXTURE/scripts/"
+  cp -R "$REPOSITORY_ROOT/apps/macos/OpenRamble" "$FIXTURE/apps/macos/"
+  cp "$REPOSITORY_ROOT/apps/macos/project.yml" "$FIXTURE/apps/macos/"
+  cp -R "$REPOSITORY_ROOT/Packages/DictationCore" "$REPOSITORY_ROOT/Packages/LocalASR" "$FIXTURE/Packages/"
+}
+
+# Runs the gate on the fixture. Sets GATE_STATUS and GATE_OUTPUT.
+run_gate() {
+  set +e
+  GATE_OUTPUT=$("$FIXTURE/scripts/check-network-surface.sh" 2>&1)
+  GATE_STATUS=$?
+  set -e
+}
+
+trap 'rm -rf "$FIXTURE"' EXIT
+
+fresh_fixture
+run_gate
+[[ $GATE_STATUS -eq 0 ]] || fail_test "clean tree was rejected:
+$GATE_OUTPUT"
+
+fresh_fixture
+printf '\nfunc leak(_ board: NSPasteboard) { board.clearContents() }\n' \
+  >> "$FIXTURE/$SOURCE_FILE"
+run_gate
+[[ $GATE_STATUS -eq 1 ]] || fail_test "naked clearContents() was not caught (exit $GATE_STATUS)"
+grep -Fq 'flushing buffer past .currentHostOnly' <<<"$GATE_OUTPUT" \
+  || fail_test "naked clearContents() failed without the clipboard message"
+
+fresh_fixture
+printf '\n// board.clearContents() is explained here, not called.\n' >> "$FIXTURE/$SOURCE_FILE"
+run_gate
+[[ $GATE_STATUS -eq 0 ]] || fail_test "a comment mentioning clearContents() was rejected:
+$GATE_OUTPUT"
+
+fresh_fixture
+printf '\nlet session = URLSession.shared\n' >> "$FIXTURE/$SOURCE_FILE"
+run_gate
+[[ $GATE_STATUS -eq 1 ]] || fail_test "URLSession outside the allowed files was not caught (exit $GATE_STATUS)"
+
+echo "Passed: network gate passes a clean tree and rejects clipboard and network violations."
