+    /// Seed 45 of the gesture storm, held still: a hands-free press inside
+    /// the hold, then the key up, then the second press that ends a
+    /// hands-free take. A moment later that is a take started and stopped.
+    /// Here the second press was dropped and the release replayed alone,
+    /// which a hands-free take ignores, so it listened with nothing left to
+    /// stop it.
+    func testAHandsFreePressAndItsStopWhileALandedPasteFinishesLeaveNoMicrophoneOn() async throws {
+        let landed = LandedPasteInserter()
+        let controller = makeController(inserter: landed)
+
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        await settle()
+        controller.stop()
+        let pasted = try await waitForPaste(landed, count: 1)
+        try await Task.sleep(until: pasted + .milliseconds(100))
+        controller.begin(handsFree: true, isEnabled: true, isModelReady: true)
+        controller.stop()
+        controller.stopHandsFree()
+        XCTAssertEqual(controller.state, .inserting)
+
+        _ = try await waitForPaste(landed, count: 2)
+        let deadline = ContinuousClock.now + .seconds(1)
+        while controller.state != .idle, ContinuousClock.now < deadline {
+            try await Task.sleep(for: .milliseconds(5))
+        }
+        XCTAssertEqual(controller.state, .idle)
+        XCTAssertFalse(controller.isHandsFreeActive)
+        let starts = await capture.startCount
+        let stops = await capture.stopCount
+        XCTAssertEqual(starts, 2)
+        XCTAssertEqual(stops, 2, "the hands-free take was stopped, not left listening")
+    }
+
+    /// A double tap inside the hold is the hands-free take it would have
+    /// been a moment later: the second tap's release ends nothing, and the
+    /// next press ends the take.
+    func testADoubleTapWhileALandedPasteFinishesIsHandsFree() async throws {
+        let landed = LandedPasteInserter()
+        let controller = makeController(inserter: landed)
+
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        await settle()
+        controller.stop()
+        let pasted = try await waitForPaste(landed, count: 1)
+        try await Task.sleep(until: pasted + .milliseconds(100))
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        controller.promoteToHandsFree()
+        controller.stop()
+        XCTAssertEqual(controller.state, .inserting)
+
+        try await Task.sleep(until: pasted + .milliseconds(600))
+        XCTAssertEqual(controller.state, .listening, "the release of a hands-free take ends nothing")
+        XCTAssertTrue(controller.isHandsFreeActive)
+        let stops = await capture.stopCount
+        XCTAssertEqual(stops, 1)
+
+        controller.stopHandsFree()
+        _ = try await waitForPaste(landed, count: 2)
+    }
+
     /// Nothing was pasted, and putting the person's clipboard back failed
     /// too. Both are said: the text is in the menu, and what they had copied
     /// is gone.
