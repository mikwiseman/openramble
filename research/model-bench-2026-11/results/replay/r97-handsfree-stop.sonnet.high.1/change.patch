diff --git a/Packages/DictationCore/Tests/DictationCoreTests/DictationControllerTests.swift b/Packages/DictationCore/Tests/DictationCoreTests/DictationControllerTests.swift
index b02b373..13424d0 100644
--- a/Packages/DictationCore/Tests/DictationCoreTests/DictationControllerTests.swift
+++ b/Packages/DictationCore/Tests/DictationCoreTests/DictationControllerTests.swift
@@ -1041,6 +1041,86 @@ final class DictationControllerTests: XCTestCase {
         XCTAssertEqual(starts, 1, "the shortcut started no take")
     }
 
+    /// Starts a dictation, ends it, and returns once its paste has landed and
+    /// only the restore floor is left, with the controller still inserting.
+    private func controllerInsideALandedPaste(
+        _ landed: LandedPasteInserter
+    ) async throws -> DictationController {
+        let controller = makeController(inserter: landed)
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        await settle()
+        controller.stop()
+        let pasted = try await waitForPaste(landed, count: 1)
+        try await Task.sleep(until: pasted + .milliseconds(80))
+        XCTAssertEqual(controller.state, .inserting)
+        return controller
+    }
+
+    private func waitForIdle(_ controller: DictationController) async throws {
+        let deadline = ContinuousClock.now + .seconds(2)
+        while controller.state != .idle, ContinuousClock.now < deadline {
+            try await Task.sleep(for: .milliseconds(5))
+        }
+    }
+
+    /// A hands-free press, and the press that ends it, both inside the hold:
+    /// a moment later the second press would have stopped the take it
+    /// started. Dropped, the take listens with nobody left to end it.
+    func testTheSecondPressOfAHandsFreeTakeWhileAPasteFinishesStopsIt() async throws {
+        let landed = LandedPasteInserter()
+        let controller = try await controllerInsideALandedPaste(landed)
+
+        controller.begin(handsFree: true, isEnabled: true, isModelReady: true)
+        controller.stopHandsFree()
+
+        _ = try await waitForPaste(landed, count: 2)
+        try await waitForIdle(controller)
+        XCTAssertEqual(controller.state, .idle, "the hands-free take was left listening")
+        let starts = await capture.startCount
+        let stops = await capture.stopCount
+        XCTAssertEqual(starts, 2)
+        XCTAssertEqual(stops, 2)
+    }
+
+    /// The double tap's second press promotes the tap that the first one
+    /// started. Inside the hold it must still make the take hands-free, so
+    /// the first tap's release does not end it.
+    func testADoubleTapWhileAPasteFinishesMakesItsTakeHandsFree() async throws {
+        let landed = LandedPasteInserter()
+        let controller = try await controllerInsideALandedPaste(landed)
+
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        controller.stop()
+        controller.promoteToHandsFree()
+
+        try await Task.sleep(for: .milliseconds(500))
+        XCTAssertTrue([.preparing, .listening].contains(controller.state), "\(controller.state)")
+        let stops = await capture.stopCount
+        XCTAssertEqual(stops, 1, "the tap's release must not stop a hands-free take")
+
+        controller.stopHandsFree()
+        _ = try await waitForPaste(landed, count: 2)
+        try await waitForIdle(controller)
+        XCTAssertEqual(controller.state, .idle)
+    }
+
+    /// Only the first press of a burst is a press; a moment later the others
+    /// would find the take already running. The first one's release stays.
+    func testASecondPressWhileAPasteFinishesDoesNotForgetTheFirstOnesRelease() async throws {
+        let landed = LandedPasteInserter()
+        let controller = try await controllerInsideALandedPaste(landed)
+
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        controller.stop()
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+
+        _ = try await waitForPaste(landed, count: 2)
+        try await waitForIdle(controller)
+        XCTAssertEqual(controller.state, .idle, "the tap's release was forgotten")
+        let starts = await capture.startCount
+        XCTAssertEqual(starts, 2)
+    }
+
     /// Nothing was pasted, and putting the person's clipboard back failed
     /// too. Both are said: the text is in the menu, and what they had copied
     /// is gone.
