+    /// A conjunction or a preposition leaves the words before it finished, and
+    /// what it joins on may open with the same word. Only the hesitation goes,
+    /// with spoken corrections on or off.
+    func testAWordSaidAgainAfterAJoiningWordIsNotARestart() {
+        let cases = [
+            ("We shipped it and, um, it works.", "We shipped it and it works."),
+            ("I'll ask Sam and, uh, Sam will know.", "I'll ask Sam and Sam will know."),
+            ("Ship it if, um, it passes review.", "Ship it if it passes review."),
+            ("I told you that, um, you should come.", "I told you that you should come."),
+            ("We talked to them about, um, them joining.", "We talked to them about them joining."),
+            ("Мы сделали это и, э, это работает.", "Мы сделали это и это работает."),
+            ("I told you that um you should come.", "I told you that you should come."),
+            ("We shipped it and, um, uh, it works.", "We shipped it and it works."),
+            ("We tested it but, uh, it failed.", "We tested it but it failed."),
+            ("Скажи ему или, э, ему напишут.", "Скажи ему или ему напишут."),
+            ("I want you to, um, you know, wait.", "I want you to you know, wait."),
+            ("You and, um, you know, Sam should talk.", "You and you know, Sam should talk."),
+            ("He logged in and, um, in the console it failed.", "He logged in and in the console it failed."),
+            // Two words said again after a coordinator are still a sentence.
+            ("I called and, uh, I called again.", "I called and I called again."),
+            ("It works and, um, it works well.", "It works and it works well."),
+            ("Мы звонили и, э, мы звонили дважды.", "Мы звонили и мы звонили дважды."),
+            // Two words said again, but not from where a clause begins.
+            ("We agreed on the plan for, um, the plan is simple.", "We agreed on the plan for the plan is simple."),
+            ("I know what he said and, um, he said nothing new.", "I know what he said and he said nothing new."),
+        ]
+        for (input, expected) in cases {
+            XCTAssertEqual(CleanVerbatim.clean(input), expected, input)
+            XCTAssertEqual(CleanVerbatim.clean(input, spokenCorrections: false), expected, "meeting: " + input)
+            XCTAssertEqual(TextPipeline().process(input).text, expected, "pipeline: " + input)
+            XCTAssertEqual(CleanVerbatim.clean(expected), expected, "idempotent: " + input)
+        }
+    }
+
+    /// After a subordinator or a preposition, two words said again from where
+    /// a clause begins are a restart: at the start of the sentence, after a
+    /// comma, after a conjunction.
+    func testARestartFromTheStartOfAClauseStillCollapses() {
+        let cases = [
+            ("I think that, um, I think we should wait.", "I think we should wait."),
+            ("Okay, I think that, um, I think we should wait.", "Okay, I think we should wait."),
+            ("Let's meet at, uh, let's meet on Monday.", "Let's meet on Monday."),
+            ("So I think that, um, I think we should wait.", "So I think we should wait."),
+            ("We paused because I think that, um, I think we should wait.", "We paused because I think we should wait."),
+            ("Давай встретимся в, э, давай встретимся на вокзале.", "Давай встретимся на вокзале."),
+            // No joining word left hanging: as before.
+            ("We're meeting with the, um, with Kowalski's team.", "We're meeting with Kowalski's team."),
+            ("I think we should, um, we could wait.", "I think we could wait."),
+        ]
+        for (input, expected) in cases {
+            XCTAssertEqual(CleanVerbatim.clean(input), expected, input)
+            XCTAssertEqual(CleanVerbatim.clean(input, spokenCorrections: false), expected, "meeting: " + input)
+            XCTAssertEqual(TextPipeline().process(input).text, expected, "pipeline: " + input)
+        }
+    }
