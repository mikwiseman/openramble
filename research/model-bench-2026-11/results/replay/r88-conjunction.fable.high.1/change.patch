+    /// A conjunction or a preposition joins what was said to what comes next,
+    /// so the same word on both sides of one is two words, not a restart:
+    /// only the hesitation goes. Spoken corrections on or off.
+    func testTheSameWordOnBothSidesOfAJoiningWordIsKept() {
+        let cases = [
+            ("We shipped it and, um, it works.", "We shipped it and it works."),
+            ("I'll ask Sam and, uh, Sam will know.", "I'll ask Sam and Sam will know."),
+            ("Ship it if, um, it passes review.", "Ship it if it passes review."),
+            ("I told you that, um, you should come.", "I told you that you should come."),
+            ("We talked to them about, um, them joining.", "We talked to them about them joining."),
+            ("Мы сделали это и, э, это работает.", "Мы сделали это и это работает."),
+            ("We shipped it and uh it works.", "We shipped it and it works."),
+            ("Я сказал тебе что, э, тебе стоит прийти.", "Я сказал тебе что тебе стоит прийти."),
+            // Two words on both sides are still two things joined.
+            ("I'll ask the team and, uh, the team will know.", "I'll ask the team and the team will know."),
+            ("Tell the team that, um, the team should come.", "Tell the team that the team should come."),
+            ("We talked to the client about, um, the client leaving.", "We talked to the client about the client leaving."),
+            // "And" joins equals even where the sentence opens.
+            ("It works and, um, it works well.", "It works and it works well."),
+            // One word before the joining word is no clause begun again.
+            ("Hold on, um, hold the release.", "Hold on hold the release."),
+            ("Step by, um, step we got there.", "Step by step we got there."),
+        ]
+        for (input, expected) in cases {
+            for spokenCorrections in [true, false] {
+                let cleaned = CleanVerbatim.clean(input, spokenCorrections: spokenCorrections)
+                XCTAssertEqual(cleaned, expected, input)
+                XCTAssertEqual(
+                    CleanVerbatim.clean(cleaned, spokenCorrections: spokenCorrections), expected, "idempotent: " + input
+                )
+            }
+        }
+    }
+
+    /// A clause begun again from its opening is a restart across a joining
+    /// word too: the first copy goes with the hesitation.
+    func testAClauseBegunAgainAcrossAJoiningWordIsARestart() {
+        let cases = [
+            ("I think that, um, I think we should wait.", "I think we should wait."),
+            ("Okay, I think that, um, I think we should wait.", "Okay, I think we should wait."),
+            ("Let's meet at, uh, let's meet on Monday.", "Let's meet on Monday."),
+            ("Я думаю что, э, я думаю нам стоит подождать.", "Я думаю нам стоит подождать."),
+        ]
+        for (input, expected) in cases {
+            for spokenCorrections in [true, false] {
+                XCTAssertEqual(CleanVerbatim.clean(input, spokenCorrections: spokenCorrections), expected, input)
+            }
+        }
+    }
