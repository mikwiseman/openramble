+    /// Seed 45 can put its last gestures inside the paste. Deliver them
+    /// synchronously on entry to .inserting so the timing is deterministic.
+    private func duringFirstPaste(
+        of controller: DictationController,
+        perform gestures: @escaping (DictationController) -> Void
+    ) {
+        controller.onStateChange = { [weak controller] state in
+            guard state == .inserting, let controller else { return }
+            controller.onStateChange = nil
+            gestures(controller)
+        }
+    }
+
+    func testHandsFreeStopDuringInsertionEndsTheQueuedTake() async throws {
+        let controller = makeController()
+        duringFirstPaste(of: controller) { controller in
+            controller.begin(handsFree: true, isEnabled: true, isModelReady: true)
+            controller.stop()
+            controller.stopHandsFree()
+        }
+
+        controller.begin(handsFree: true, isEnabled: true, isModelReady: true)
+        controller.stopHandsFree()
+        await quiesce(controller)
+
+        let recording = await capture.isRecording
+        XCTAssertFalse(recording)
+        XCTAssertEqual(controller.state, .idle)
+        let before = await inserter.insertedTexts.count
+        XCTAssertEqual(before, 2)
+
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        controller.stop()
+        await quiesce(controller)
+        let inserted = await inserter.insertedTexts
+        XCTAssertEqual(inserted.count, 3, "the next dictation must insert exactly once")
+    }
+
+    func testPromotionDuringInsertionSupersedesTheQueuedRelease() async throws {
+        let controller = makeController()
+        duringFirstPaste(of: controller) { controller in
+            controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+            controller.stop()
+            controller.promoteToHandsFree()
+            controller.stop() // releasing the second tap does not end hands-free
+        }
+
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        controller.stop()
+        let deadline = ContinuousClock.now + .seconds(2)
+        while !(controller.isHandsFreeActive && controller.state == .listening), ContinuousClock.now < deadline {
+            try await Task.sleep(for: .milliseconds(1))
+        }
+        XCTAssertTrue(controller.isHandsFreeActive)
+        XCTAssertEqual(controller.state, .listening)
+        controller.stopHandsFree()
+        await quiesce(controller)
+        let recording = await capture.isRecording
+        XCTAssertFalse(recording)
+        let inserted = await inserter.insertedTexts
+        XCTAssertEqual(inserted.count, 2)
+    }
+
+    func testQueuedReleaseCannotStopATakeStartedByAnIdleObserver() async throws {
+        let controller = makeController()
+        var queued = false
+        var observerStarted = false
+        controller.onStateChange = { [weak controller] state in
+            guard let controller else { return }
+            if state == .inserting, !queued {
+                queued = true
+                controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+                controller.stop()
+            } else if state == .idle, queued, !observerStarted {
+                observerStarted = true
+                controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+            }
+        }
+
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        controller.stop()
+        let deadline = ContinuousClock.now + .seconds(2)
+        while !(observerStarted && controller.state == .listening), ContinuousClock.now < deadline {
+            try await Task.sleep(for: .milliseconds(1))
+        }
+        XCTAssertEqual(controller.state, .listening)
+        controller.stop()
+        await quiesce(controller)
+        let inserted = await inserter.insertedTexts
+        XCTAssertEqual(inserted.count, 2)
+    }
