+/// The next take's gesture while a paste still owns the clipboard. A double
+/// tap promotes it to `.handsFree`, superseding the first tap's release.
+public enum DictationPress: Sendable {
+    case held, released, handsFree, stoppedHandsFree
+
+    public var isHandsFree: Bool { self == .handsFree || self == .stoppedHandsFree }
+    var stopRequested: Bool { self == .released || self == .stoppedHandsFree }
+
+    public mutating func release() {
+        if self == .held { self = .released }
+    }
+
+    public mutating func stopHandsFree() {
+        if self == .handsFree { self = .stoppedHandsFree }
+    }
+}
+
