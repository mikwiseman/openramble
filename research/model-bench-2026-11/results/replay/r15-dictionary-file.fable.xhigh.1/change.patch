+    func testNoImportEverLosesMovesOrMiscounts() throws {
+        // "Never" is a promise about every import, so it is held to a few
+        // thousand of them: repeated phrases, other cases, padded and empty
+        // sides, in any mix. The sequence is fixed, so a failure repeats.
+        var state: UInt64 = 0x0D1C_7104
+        func roll(_ bound: Int) -> Int {
+            state = state &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
+            return Int((state >> 33) % UInt64(bound))
+        }
+        func pick(_ pool: [String]) -> String { pool[roll(pool.count)] }
+        func entry(spoken: [String], written: [String]) -> DictionaryReplacement {
+            DictionaryReplacement(
+                spoken: pick(spoken),
+                written: pick(written),
+                inflects: roll(4) != 0,
+                noAcousticBoost: roll(4) == 0
+            )
+        }
+        func trimmed(_ text: String) -> String { text.trimmingCharacters(in: .whitespacesAndNewlines) }
+
+        // Mine is what the application can hold. The file is anything.
+        let mySpoken = ["sentry", "Sentry", "SENTRY", "figma", "linear"]
+        let myWritten = ["Sentry", "sentry", "Figma", "Linear"]
+        let fileSpoken = mySpoken + [" sentry ", "FIGMA\n", "notion", "Notion", "", "  "]
+        let fileWritten = myWritten + [" Sentry ", "Notion", "", "\t"]
+
+        for _ in 0..<3000 {
+            let mine = (0..<roll(6)).map { _ in entry(spoken: mySpoken, written: myWritten) }
+            let file = (0..<roll(7)).map { _ in entry(spoken: fileSpoken, written: fileWritten) }
+
+            let result = DictionaryTransfer.merge(existing: mine, imported: file)
+            let after = result.replacements
+            let new = after.dropFirst(mine.count)
+
+            // Mine are all there, in their places, under their ids.
+            XCTAssertEqual(after.prefix(mine.count).map(\.id), mine.map(\.id))
+            // What the file does not name is not touched.
+            let named = Set(file.map { trimmed($0.spoken).lowercased() })
+            for (before, now) in zip(mine, after) where !named.contains(before.spoken.lowercased()) {
+                XCTAssertEqual(now, before)
+            }
+            // New phrases come after mine, in the order of the file, tidy.
+            XCTAssertEqual(new.map(\.id), file.map(\.id).filter(Set(new.map(\.id)).contains))
+            XCTAssertTrue(new.allSatisfy { !$0.spoken.isEmpty && $0.spoken == trimmed($0.spoken) })
+            XCTAssertTrue(new.allSatisfy { !$0.written.isEmpty && $0.written == trimmed($0.written) })
+            // The counts are the real changes, no more and no fewer.
+            XCTAssertEqual(result.added, new.count)
+            XCTAssertEqual(result.updated, zip(mine, after).filter { $0 != $1 }.count)
+
+            // The same file again, or my own copy, changes nothing.
+            let settled = DictionaryTransfer.MergeResult(replacements: after, added: 0, updated: 0)
+            XCTAssertEqual(DictionaryTransfer.merge(existing: after, imported: file), settled)
+            let copy = try DictionaryTransfer.read(try DictionaryTransfer.export(after))
+            XCTAssertEqual(DictionaryTransfer.merge(existing: after, imported: copy), settled)
+            // And on an empty Mac the copy is the dictionary again.
+            XCTAssertEqual(
+                phrases(DictionaryTransfer.merge(existing: [], imported: copy).replacements),
+                phrases(after)
+            )
+        }
+    }
