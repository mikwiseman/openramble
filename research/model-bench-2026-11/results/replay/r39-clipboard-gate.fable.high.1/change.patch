diff --git a/scripts/tests/test-network-surface-gate.sh b/scripts/tests/test-network-surface-gate.sh
new file mode 100755
index 0000000..1c34040
--- /dev/null
+++ b/scripts/tests/test-network-surface-gate.sh
@@ -0,0 +1,156 @@
+#!/bin/bash
+# Proves that check-network-surface.sh catches what it is there to catch.
+#
+# The gate once ran for weeks with its clipboard pattern undefined: bash printed
+# "FORBIDDEN_PASTEBOARD: unbound variable", the check searched for nothing, and
+# the gate reported success. A gate is only worth its green when a planted
+# violation turns it red, so every check is planted against here - in a
+# throwaway copy of the shipping sources, never in the repository itself.
+
+set -euo pipefail
+
+REPOSITORY_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+WORK=$(mktemp -d)
+trap 'rm -rf "$WORK"' EXIT
+
+COPY="$WORK/repo"
+GATE="$COPY/scripts/check-network-surface.sh"
+PLANT="$COPY/apps/macos/OpenRamble/System/Planted.swift"
+PROJECT_YML="$COPY/apps/macos/project.yml"
+RUNTIME="$COPY/Packages/LocalASR/.build/CTranscribe.framework/CTranscribe"
+
+mkdir -p "$COPY/scripts" "$COPY/Packages/DictationCore" "$COPY/Packages/LocalASR" "$COPY/apps/macos"
+cp "$REPOSITORY_ROOT/scripts/check-network-surface.sh" "$GATE"
+cp -R "$REPOSITORY_ROOT/Packages/DictationCore/Sources" "$COPY/Packages/DictationCore/Sources"
+cp -R "$REPOSITORY_ROOT/Packages/LocalASR/Sources" "$COPY/Packages/LocalASR/Sources"
+cp -R "$REPOSITORY_ROOT/apps/macos/OpenRamble" "$COPY/apps/macos/OpenRamble"
+cp "$REPOSITORY_ROOT/apps/macos/project.yml" "$PROJECT_YML"
+
+fail_test() {
+  printf 'FAIL: %s\n' "$1" >&2
+  [[ -z "${OUTPUT:-}" ]] || printf '%s\n' "--- gate output ---" "$OUTPUT" >&2
+  exit 1
+}
+
+run_gate() {
+  GATE_STATUS=0
+  OUTPUT=$(/bin/bash "$GATE" 2>&1) || GATE_STATUS=$?
+}
+
+expect_pass() {
+  run_gate
+  [[ $GATE_STATUS -eq 0 ]] || fail_test "gate rejected $1"
+  printf '  passes   %s\n' "$1"
+}
+
+# The gate must fail AND say why: a red gate that names the wrong thing, or
+# nothing, gets bypassed.
+expect_caught() {
+  run_gate
+  [[ $GATE_STATUS -ne 0 ]] || fail_test "gate let through $1"
+  grep -Fq -- "$2" <<<"$OUTPUT" || fail_test "gate failed on $1 without reporting '$2'"
+  printf '  catches  %s\n' "$1"
+}
+
+plant_swift() {
+  printf '%s\n' "$1" > "$PLANT"
+}
+
+build_runtime() {
+  mkdir -p "$(dirname "$RUNTIME")"
+  cc -x c -dynamiclib -o "$RUNTIME" - <<<"$1"
+}
+
+echo "Network surface gate:"
+
+expect_pass "the shipping sources as they are"
+
+# --- Network symbols --------------------------------------------------------
+
+plant_swift 'let session = URLSession.shared'
+expect_caught "URLSession outside the two permitted files" "Planted.swift:1:"
+
+plant_swift 'let text = try String(contentsOf: remote)'
+expect_caught "a silent download initializer" "Planted.swift:1:"
+
+plant_swift 'let recognizer = SFSpeechRecognizer()'
+expect_caught "speech sent to Apple servers" "Planted.swift:1:"
+
+plant_swift '// URLSession is only allowed in ModelDownloading.swift.'
+expect_pass "a comment that names a network symbol"
+
+# --- Clipboard --------------------------------------------------------------
+
+plant_swift '        pasteboard.clearContents()'
+expect_caught "a plain clearContents()" "Planted.swift:1:"
+grep -Fq "Universal Clipboard" <<<"$OUTPUT" \
+  || fail_test "clipboard violation does not explain the Universal Clipboard leak"
+
+plant_swift 'NSPasteboard.general.declareTypes([.string], owner: nil)'
+expect_caught "declareTypes, the older spelling of clearContents" "Planted.swift:1:"
+
+plant_swift 'pasteboard.prepareForNewContents()'
+expect_caught "prepareForNewContents without options" "Planted.swift:1:"
+
+plant_swift 'pasteboard.prepareForNewContents(with: [])'
+expect_caught "prepareForNewContents with empty options" "Planted.swift:1:"
+
+# Both violations at once: the clipboard one must not hide behind the first.
+plant_swift 'let session = URLSession.shared
+pasteboard.clearContents()'
+expect_caught "a clipboard violation next to a network one" "Planted.swift:2:"
+grep -Fq "Universal Clipboard" <<<"$OUTPUT" \
+  || fail_test "clipboard violation is reported under the network heading"
+
+plant_swift '    /// A plain `clearContents()` is prohibited here.
+    pasteboard.prepareForNewContents(with: .currentHostOnly)'
+expect_pass "a host-only write and a comment that names clearContents()"
+
+rm "$PLANT"
+
+# --- Update settings --------------------------------------------------------
+
+for key in SUEnableAutomaticChecks SUSendProfileInfo SUAllowsAutomaticUpdates; do
+  cp "$PROJECT_YML" "$WORK/project.yml"
+  grep -v "$key" "$WORK/project.yml" > "$PROJECT_YML"
+  expect_caught "project.yml without $key" "$key"
+  cp "$WORK/project.yml" "$PROJECT_YML"
+done
+
+# --- Dictated text in logs --------------------------------------------------
+
+plant_swift 'logger.info("heard \(transcript)")'
+expect_caught "dictated text written to the log" "Planted.swift:1:"
+rm "$PLANT"
+
+# --- Inference runtime binary -----------------------------------------------
+
+build_runtime 'int add(int a, int b) { return a + b; }'
+expect_pass "an inference runtime with no network references"
+grep -Fq "cannot reach the network" <<<"$OUTPUT" \
+  || fail_test "audited runtime is not reported as audited"
+
+build_runtime 'int socket(int, int, int); int reach(void) { return socket(2, 1, 0); }'
+expect_caught "an inference runtime that opens a socket" "_socket"
+
+rm -rf "$COPY/Packages/LocalASR/.build"
+expect_pass "sources before the runtime is resolved"
+if grep -Fq "cannot reach the network" <<<"$OUTPUT"; then
+  fail_test "gate vouches for a runtime binary it never audited"
+fi
+
+# --- A check that cannot run must not pass -----------------------------------
+
+# The original incident: a pattern that is never defined.
+cp "$GATE" "$WORK/gate.sh"
+grep -v '^FORBIDDEN_PASTEBOARD=' "$WORK/gate.sh" > "$GATE"
+expect_caught "its own clipboard pattern going missing" "FORBIDDEN_PASTEBOARD"
+cp "$WORK/gate.sh" "$GATE"
+
+mv "$COPY/Packages/DictationCore/Sources" "$WORK/Sources"
+expect_caught "a shipping directory it cannot search" "Packages/DictationCore/Sources"
+mv "$WORK/Sources" "$COPY/Packages/DictationCore/Sources"
+
+expect_pass "the shipping sources once everything is restored"
+
+printf 'PASS: the network gate catches every violation it names\n'
