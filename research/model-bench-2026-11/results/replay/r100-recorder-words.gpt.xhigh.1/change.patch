     }
+
+    func testPauseCutsKeepTheLastSpeechAfterLeadingSilence() async throws {
+        let microphone = ScriptedAudioSource()
+        let segments = UncheckedBox<[MeetingSegmentRef]>([])
+        let capture = MeetingCapture(
+            directory: directory,
+            microphone: microphone,
+            systemAudio: nil,
+            onSegment: { segments.value.append($0) }
+        )
+        try await capture.start()
+        // Twenty millisecond blocks, including a distinct ending to each phrase.
+        for _ in 0..<2 {
+            for _ in 0..<150 { microphone.deliver(constant(0, 320)) }
+            for _ in 0..<490 { microphone.deliver(constant(0.5, 320)) }
+            for _ in 0..<10 { microphone.deliver(constant(0.25, 320)) }
+        }
+        for _ in 0..<150 { microphone.deliver(constant(0, 320)) }
+        _ = try await capture.stop()
+
+        let reader = MeetingPCMWindowReader(url: await capture.audioURL)
+        XCTAssertEqual(segments.value.map(\.startFrame), [32_000, 240_000])
+        XCTAssertEqual(segments.value.map(\.endFrame), [213_600, 421_600])
+        for segment in segments.value {
+            let samples = try reader.read(segment)
+            XCTAssertEqual(samples.filter { abs($0 - 0.25) < 0.001 }.count, 3_200)
+            XCTAssertTrue(samples.suffix(5_600).allSatisfy { $0 == 0 })
+        }
+    }
+
+    func testQuietSystemSpeechReachesTranscriptionOnItsOwnChannel() async throws {
+        let microphone = ScriptedAudioSource()
+        let system = ScriptedAudioSource()
+        let segments = UncheckedBox<[MeetingSegmentRef]>([])
+        let capture = MeetingCapture(
+            directory: directory,
+            microphone: microphone,
+            systemAudio: system,
+            onSegment: { segments.value.append($0) },
+            probe: {}
+        )
+        try await capture.start()
+        let quiet = (0..<320).map { Float(sin(2 * Double.pi * Double($0) / 40)) * 0.005 }
+        let leak = quiet.map { $0 * 0.5 }
+        for _ in 0..<150 {
+            microphone.deliver(leak)
+            system.deliver(quiet)
+        }
+        for _ in 0..<150 {
+            microphone.deliver(constant(0.5, 320))
+            system.deliver(constant(0, 320))
+        }
+        let summary = try await capture.stop()
+
+        let reader = MeetingPCMWindowReader(url: await capture.audioURL)
+        XCTAssertTrue(summary.systemAudio.everDeliveredAudio)
+        XCTAssertEqual(try reader.read(channel: .system, startFrame: 0, frameCount: 320)[10], 0.005, accuracy: 0.0001)
+        XCTAssertEqual(segments.value.filter { $0.channel == .microphone }.map(\.startFrame), [32_000])
+        let remote = try XCTUnwrap(segments.value.first { $0.channel == .system })
+        XCTAssertEqual(remote.startFrame, 0)
+        XCTAssertEqual(try reader.read(remote)[10], 0.005, accuracy: 0.0001)
+    }
+
+    func testTheSystemAudioProbeShowsTheTapIsAliveWithoutSubmittingSpeech() async throws {
+        let system = ScriptedAudioSource()
+        let segments = UncheckedBox<[MeetingSegmentRef]>([])
+        let capture = MeetingCapture(
+            directory: directory,
+            microphone: nil,
+            systemAudio: system,
+            onSegment: { segments.value.append($0) },
+            probe: {}
+        )
+        try await capture.start()
+        let probeURL = directory.appending(path: "probe.wav")
+        try SystemAudioProbe.wavData().write(to: probeURL)
+        let file = try AVAudioFile(forReading: probeURL)
+        let buffer = try XCTUnwrap(
+            AVAudioPCMBuffer(pcmFormat: file.processingFormat, frameCapacity: AVAudioFrameCount(file.length))
+        )
+        try file.read(into: buffer)
+        let target = try XCTUnwrap(AVAudioFormat(standardFormatWithSampleRate: Double(MeetingWriter.sampleRate), channels: 1))
+        let converter = try MicrophoneCapture.converter(from: buffer.format, to: target) {
+            AVAudioConverter(from: $0, to: $1)
+        }
+        system.deliver(try MicrophoneCapture.extractSamples(from: buffer, using: converter, target: target))
+        let summary = try await capture.stop()
+
+        XCTAssertTrue(summary.systemAudio.everDeliveredAudio)
+        XCTAssertTrue(segments.value.isEmpty)
+    }
