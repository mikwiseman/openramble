diff --git a/Packages/DictationCore/Tests/DictationAudioTests/MeetingCaptureTests.swift b/Packages/DictationCore/Tests/DictationAudioTests/MeetingCaptureTests.swift
index e84ed9a..753b898 100644
--- a/Packages/DictationCore/Tests/DictationAudioTests/MeetingCaptureTests.swift
+++ b/Packages/DictationCore/Tests/DictationAudioTests/MeetingCaptureTests.swift
@@ -601,6 +601,36 @@ extension MeetingCaptureTests {
 }
 
 extension MeetingCaptureTests {
+    func testQuietCallAudioReachesTranscriptionOnlyOnTheSystemChannel() async throws {
+        let microphone = ScriptedAudioSource()
+        let system = ScriptedAudioSource()
+        let segments = UncheckedBox<[MeetingSegmentRef]>([])
+        let capture = MeetingCapture(
+            directory: directory, microphone: microphone, systemAudio: system,
+            onSegment: { segments.value.append($0) }, probe: {}
+        )
+        try await capture.start()
+        let remoteVoice = constant(0.002, 1_600)
+        let speakerLeak = constant(0.001, 1_600)
+        for _ in 0..<120 {
+            microphone.deliver(speakerLeak)
+            system.deliver(remoteVoice)
+        }
+        for _ in 0..<10 {
+            microphone.deliver(constant(0, 1_600))
+            system.deliver(constant(0, 1_600))
+        }
+        let summary = try await capture.stop()
+
+        XCTAssertEqual(segments.value.map(\.channel), [.system])
+        let segment = try XCTUnwrap(segments.value.first)
+        XCTAssertGreaterThan(segment.endFrame, 12 * 16_000)
+        XCTAssertLessThan(segment.endFrame, summary.frameCount, "the pause closed the segment before stop")
+        let reader = MeetingPCMWindowReader(url: await capture.audioURL)
+        let samples = try reader.read(segment)
+        XCTAssertEqual(try XCTUnwrap(samples.first), remoteVoice[0], accuracy: 1 / 32_768)
+    }
+
     /// The speakers leaking into the microphone are not the person speaking:
     /// the other side's sentence is one segment on its own channel, not two.
     func testTheOtherSideLeakingIntoTheMicrophoneIsNotSegmentedAsYou() async throws {
