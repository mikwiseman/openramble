+    func testPauseCutsStayInsideSilenceAfterTrimmingTheStartAndBetweenTurns() throws {
+        var position = frames(2)
+        var policy = MeetingSegmentPolicy(channel: .system, startFrame: position)
+        for silence in [3_600.0, 5.0] {
+            XCTAssertEqual(feed(&policy, quiet, seconds: silence), [])
+            position += frames(silence)
+            XCTAssertEqual(policy.pendingFrames, frames(1))
+            XCTAssertEqual(feed(&policy, speech, seconds: 12), [])
+            let cuts = feed(&policy, quiet, seconds: 1)
+            XCTAssertEqual(cuts.count, 1)
+            let cut = try XCTUnwrap(cuts.first)
+            XCTAssertEqual(cut.startFrame, position - frames(1))
+            position += frames(12)
+            XCTAssertEqual(cut.endFrame, position + frames(0.35), "halfway into the 700 ms pause")
+            position += frames(1)
+        }
+        XCTAssertNil(policy.flush())
     }
