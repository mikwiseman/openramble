+    /// A hands-free take started and stopped inside the hold: a moment later
+    /// the second press would have ended it, so it ends. The storm found this
+    /// one (seed 45): the start was kept and the stop dropped, and the take
+    /// listened with nothing left that could end it.
+    func testAHandsFreeTakeStartedAndStoppedWhileALandedPasteFinishesStops() async throws {
+        let landed = LandedPasteInserter()
+        let controller = makeController(inserter: landed)
+
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        await settle()
+        controller.stop()
+        let pasted = try await waitForPaste(landed, count: 1)
+        try await Task.sleep(until: pasted + .milliseconds(100))
+        controller.begin(handsFree: true, isEnabled: true, isModelReady: true)
+        try await Task.sleep(until: pasted + .milliseconds(150))
+        controller.stopHandsFree()
+        XCTAssertEqual(controller.state, .inserting)
+
+        _ = try await waitForPaste(landed, count: 2)
+        let deadline = ContinuousClock.now + .seconds(1)
+        while controller.state != .idle, ContinuousClock.now < deadline {
+            try await Task.sleep(for: .milliseconds(5))
+        }
+        XCTAssertEqual(controller.state, .idle)
+        XCTAssertFalse(controller.isHandsFreeActive)
+        let starts = await capture.startCount
+        let stops = await capture.stopCount
+        XCTAssertEqual(starts, 2)
+        XCTAssertEqual(stops, 2, "the hands-free take was stopped, not left listening")
+    }
+
+    /// A double tap inside the hold is the hands-free take it would have been
+    /// a moment later: its second release does not end it.
+    func testADoubleTapWhileALandedPasteFinishesGoesHandsFree() async throws {
+        let landed = LandedPasteInserter()
+        let controller = makeController(inserter: landed)
+
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        await settle()
+        controller.stop()
+        let pasted = try await waitForPaste(landed, count: 1)
+        try await Task.sleep(until: pasted + .milliseconds(100))
+        // A double tap as the hotkey delivers it: the first press, the double
+        // tap itself (the first release is swallowed), then the second release.
+        controller.begin(handsFree: false, isEnabled: true, isModelReady: true)
+        controller.promoteToHandsFree()
+        try await Task.sleep(until: pasted + .milliseconds(150))
+        controller.stop()
+        XCTAssertEqual(controller.state, .inserting)
+
+        let deadline = ContinuousClock.now + .seconds(1)
+        while controller.state != .listening, ContinuousClock.now < deadline {
+            try await Task.sleep(for: .milliseconds(5))
+        }
+        await settle()
+        XCTAssertEqual(controller.state, .listening, "the second release does not end a hands-free take")
+        XCTAssertTrue(controller.isHandsFreeActive)
+
+        controller.stopHandsFree()
+        _ = try await waitForPaste(landed, count: 2)
+    }
+
