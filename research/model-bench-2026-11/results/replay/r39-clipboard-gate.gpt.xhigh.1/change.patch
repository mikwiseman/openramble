@@ -0,0 +1,61 @@
+#!/bin/bash
+
+set -euo pipefail
+
+REPOSITORY_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+TEST_ROOT=$(mktemp -d "$REPOSITORY_ROOT/.network-surface-test.XXXXXX")
+trap 'find "$TEST_ROOT" -depth -delete' EXIT
+cd "$TEST_ROOT"
+
+mkdir -p scripts Packages/DictationCore/Sources Packages/LocalASR/Sources/LocalASR \
+  apps/macos/OpenRamble apps/macos/OpenRambleTests
+cp "$REPOSITORY_ROOT/scripts/check-network-surface.sh" scripts/
+cp "$REPOSITORY_ROOT/apps/macos/project.yml" apps/macos/
+
+fail_test() {
+  printf 'FAIL: %s\n' "$1" >&2
+  cat gate.out gate.err >&2
+  exit 1
+}
+
+run_gate() {
+  local expected="$1" description="$2" actual=0
+  ./scripts/check-network-surface.sh > gate.out 2> gate.err || actual=$?
+  [[ "$actual" -eq "$expected" ]] \
+    || fail_test "$description (expected exit $expected, got $actual)"
+  if [[ "$expected" -eq 0 && -s gate.err ]]; then
+    fail_test "$description (unexpected stderr)"
+  fi
+}
+
+require_output() {
+  grep -Fq -- "$1" "$2" || fail_test "expected $2 to include $1"
+}
+
+PASTEBOARD_SOURCE=apps/macos/OpenRamble/PasteboardFixture.swift
+printf 'pasteboard.prepareForNewContents(with: .currentHostOnly)\n' > "$PASTEBOARD_SOURCE"
+run_gate 0 'host-only clipboard preparation'
+
+printf '    // Avoid pasteboard.clearContents()\n' >> "$PASTEBOARD_SOURCE"
+printf '\t/// Use host-only preparation instead of clearContents().\n' >> "$PASTEBOARD_SOURCE"
+printf 'pasteboard.clearContents()\n' > apps/macos/OpenRambleTests/PasteboardFixture.swift
+printf 'let session = URLSession.shared\n' > Packages/LocalASR/Sources/LocalASR/ModelDownloading.swift
+run_gate 0 'clipboard comments, test code and the allowed model downloader'
+
+printf 'pasteboard.clearContents()\n' >> "$PASTEBOARD_SOURCE"
+run_gate 1 'a shipping clearContents() call'
+require_output "$PASTEBOARD_SOURCE:4:pasteboard.clearContents()" gate.err
+require_output 'prepareForNewContents(with: .currentHostOnly)' gate.err
+
+NETWORK_SOURCE=Packages/DictationCore/Sources/NetworkFixture.swift
+printf 'let session = URLSession.shared\n' > "$NETWORK_SOURCE"
+run_gate 1 'simultaneous network and clipboard violations'
+require_output "$NETWORK_SOURCE:1:let session = URLSession.shared" gate.out
+require_output "$PASTEBOARD_SOURCE:4:pasteboard.clearContents()" gate.err
+
+printf 'pasteboard.prepareForNewContents(with: .currentHostOnly)\n' > "$PASTEBOARD_SOURCE"
+mv Packages/DictationCore/Sources Packages/DictationCore/MissingSources
+run_gate 1 'missing shipping sources'
+require_output 'could not scan shipping sources for clipboard calls' gate.err
+
+printf 'PASS: network surface gate accepts safe clipboard code and rejects violations and scan errors\n'
