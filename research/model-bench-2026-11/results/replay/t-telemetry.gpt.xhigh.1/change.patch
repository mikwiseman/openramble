diff --git a/apps/macos/OpenRambleTests/DailyDictationUsageTests.swift b/apps/macos/OpenRambleTests/DailyDictationUsageTests.swift
new file mode 100644
index 0000000..fb10d40
--- /dev/null
+++ b/apps/macos/OpenRambleTests/DailyDictationUsageTests.swift
@@ -0,0 +1,143 @@
+import Foundation
+import os
+import XCTest
+
+@MainActor
+final class DailyDictationUsageTests: XCTestCase {
+    func testLaunchReportsEarlierCounts() async throws {
+        let usage = makeUsage(defaults: UsageDefaults())
+        usage.recordDictation(at: .now.addingTimeInterval(-86_400))
+        let loaded = expectation(description: "daily report request")
+        UsageURLProtocol.state.withLock { $0.loaded = loaded }
+
+        usage.start()
+        await fulfillment(of: [loaded], timeout: 2)
+        XCTAssertEqual(try payload(XCTUnwrap(UsageURLProtocol.requests.first)).first?["count"], 1)
+    }
+
+    func testReportsCompletedDaysOnlyOnceAcrossRelaunch() async throws {
+        let defaults = UsageDefaults()
+        let usage = makeUsage(defaults: defaults)
+        usage.recordDictation(at: date(20_000))
+        usage.recordDictation(at: date(20_001).addingTimeInterval(-1))
+        await usage.reportIfDue(at: date(20_000))
+        XCTAssertTrue(UsageURLProtocol.requests.isEmpty)
+
+        let relaunched = makeUsage(defaults: defaults)
+        let reportDate = date(20_001)
+        relaunched.recordDictation(at: reportDate)
+        async let first: Void = relaunched.reportIfDue(at: reportDate)
+        async let second: Void = relaunched.reportIfDue(at: reportDate)
+        _ = await (first, second)
+        await makeUsage(defaults: defaults).reportIfDue(at: date(20_001))
+
+        let requests = UsageURLProtocol.requests
+        XCTAssertEqual(requests.count, 1)
+        let request = try XCTUnwrap(requests.first)
+        XCTAssertEqual(request.url?.absoluteString, "https://stats.waiwai.is/ramble")
+        XCTAssertEqual(request.httpMethod, "POST")
+        XCTAssertEqual(request.value(forHTTPHeaderField: "Content-Type"), "application/json")
+        XCTAssertEqual(request.value(forHTTPHeaderField: "User-Agent"), "OpenRamble")
+        XCTAssertEqual(request.value(forHTTPHeaderField: "Accept-Language"), "*")
+        XCTAssertNil(request.value(forHTTPHeaderField: "Cookie"))
+        XCTAssertNil(request.value(forHTTPHeaderField: "Authorization"))
+        XCTAssertEqual(try payload(request), [["day": 20_000, "count": 2]])
+
+        await relaunched.reportIfDue(at: date(20_002))
+        XCTAssertEqual(try UsageURLProtocol.requests.map(payload), [
+            [["day": 20_000, "count": 2]], [["day": 20_001, "count": 1]],
+        ])
+        await relaunched.reportIfDue(at: date(20_003))
+        XCTAssertEqual(UsageURLProtocol.requests.count, 2)
+    }
+
+    func testFailedUploadIsRetriedWithNewCountsOnTheNextDay() async throws {
+        let defaults = UsageDefaults()
+        let usage = makeUsage(defaults: defaults)
+        UsageURLProtocol.state.withLock { $0.status = 503 }
+        usage.recordDictation(at: date(20_000))
+        await usage.reportIfDue(at: date(20_001))
+        await makeUsage(defaults: defaults).reportIfDue(at: date(20_001))
+        XCTAssertEqual(UsageURLProtocol.requests.count, 1)
+
+        UsageURLProtocol.state.withLock { $0.status = 204 }
+        let relaunched = makeUsage(defaults: defaults)
+        relaunched.recordDictation(at: date(20_001))
+        await relaunched.reportIfDue(at: date(20_002))
+        XCTAssertEqual(try UsageURLProtocol.requests.map(payload), [
+            [["day": 20_000, "count": 1]], [["day": 20_000, "count": 1], ["day": 20_001, "count": 1]],
+        ])
+        XCTAssertNil(UsageURLProtocol.requests.last?.value(forHTTPHeaderField: "Cookie"))
+    }
+
+    private func makeUsage(defaults: UserDefaults) -> DailyDictationUsage {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [UsageURLProtocol.self]
+        return DailyDictationUsage(defaults: defaults, configuration: configuration)
+    }
+
+    private func date(_ day: Int) -> Date {
+        Date(timeIntervalSince1970: Double(day) * 86_400)
+    }
+
+    private func payload(_ request: URLRequest) throws -> [[String: Int]] {
+        try JSONDecoder().decode([[String: Int]].self, from: XCTUnwrap(request.httpBody))
+    }
+
+    override func setUp() {
+        UsageURLProtocol.state.withLock { $0 = .init() }
+    }
+}
+
+private final class UsageDefaults: UserDefaults {
+    private var storedData: [String: Data] = [:]
+
+    override func data(forKey defaultName: String) -> Data? { storedData[defaultName] }
+
+    override func set(_ value: Any?, forKey defaultName: String) {
+        storedData[defaultName] = value as? Data
+    }
+}
+
+private final class UsageURLProtocol: URLProtocol, @unchecked Sendable {
+    struct State {
+        var requests: [URLRequest] = []
+        var status = 204
+        var loaded: XCTestExpectation?
+    }
+
+    static let state = OSAllocatedUnfairLock(initialState: State())
+    static var requests: [URLRequest] { state.withLock { $0.requests } }
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+    override func startLoading() {
+        var captured = request
+        if let stream = request.httpBodyStream {
+            stream.open()
+            defer { stream.close() }
+            var body = Data()
+            var buffer = [UInt8](repeating: 0, count: 512)
+            while true {
+                let count = stream.read(&buffer, maxLength: buffer.count)
+                guard count > 0 else { break }
+                body.append(buffer, count: count)
+            }
+            captured.httpBody = body
+        }
+        let (status, loaded) = Self.state.withLock { [captured] in
+            $0.requests.append(captured)
+            return ($0.status, $0.loaded)
+        }
+        let response = HTTPURLResponse(
+            url: request.url!, statusCode: status, httpVersion: "HTTP/1.1",
+            headerFields: ["Set-Cookie": "example=1; Secure"]
+        )!
+        client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+        client?.urlProtocolDidFinishLoading(self)
+        loaded?.fulfill()
+    }
+
+    override func stopLoading() {}
+}
