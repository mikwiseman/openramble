index 0000000..65632d7
--- /dev/null
+++ b/apps/macos/OpenRamble/System/DailyDictationUsage.swift
@@ -0,0 +1,111 @@
+import Foundation
+
+/// A local count of successful dictations, grouped by completed UTC day.
+@MainActor
+final class DailyDictationUsage {
+    private struct State: Codable {
+        var counts: [Int: Int] = [:]
+        var lastAttemptDay: Int?
+    }
+
+    private struct Report: Encodable {
+        let day: Int
+        let count: Int
+    }
+
+    private static let defaultsKey = "dailyDictationUsage"
+    private static let endpoint = URL(string: "https://stats.waiwai.is/ramble")!
+    private static let secondsPerDay: TimeInterval = 86_400
+
+    private let defaults: UserDefaults
+    private let session: URLSession
+    private var state: State
+    private var isSending = false
+    nonisolated(unsafe) private var timer: Timer?
+
+    init(defaults: UserDefaults, configuration: URLSessionConfiguration = .ephemeral) {
+        self.defaults = defaults
+        state = defaults.data(forKey: Self.defaultsKey)
+            .flatMap { try? JSONDecoder().decode(State.self, from: $0) } ?? State()
+
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        configuration.urlCredentialStorage = nil
+        configuration.urlCache = nil
+        configuration.waitsForConnectivity = true
+        configuration.timeoutIntervalForResource = 30
+        session = URLSession(configuration: configuration, delegate: NoRedirects(), delegateQueue: nil)
+    }
+
+    deinit {
+        timer?.invalidate()
+        session.invalidateAndCancel()
+    }
+
+    func start() {
+        guard timer == nil else { return }
+        let interval = Self.secondsPerDay
+        let nextMidnight = Date(timeIntervalSince1970: Double(Self.day(at: .now) + 1) * interval)
+        let timer = Timer(fire: nextMidnight, interval: interval, repeats: true) { [weak self] _ in
+            Task { await self?.reportIfDue() }
+        }
+        timer.tolerance = 60
+        RunLoop.main.add(timer, forMode: .common)
+        self.timer = timer
+        Task { [weak self] in await self?.reportIfDue() }
+    }
+
+    func recordDictation(at date: Date = .now) {
+        state.counts[Self.day(at: date), default: 0] += 1
+        save()
+    }
+
+    func reportIfDue(at date: Date = .now) async {
+        let day = Self.day(at: date)
+        guard !isSending, day > (state.lastAttemptDay ?? .min) else { return }
+
+        let reports = state.counts.filter { $0.key < day }.sorted { $0.key < $1.key }
+            .map { Report(day: $0.key, count: $0.value) }
+        guard !reports.isEmpty, let body = try? JSONEncoder().encode(reports) else { return }
+        var request = URLRequest(url: Self.endpoint)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("OpenRamble", forHTTPHeaderField: "User-Agent")
+        request.setValue("*", forHTTPHeaderField: "Accept-Language")
+        request.httpBody = body
+
+        // Persist the attempt before sending so a relaunch cannot retry it the same day.
+        state.lastAttemptDay = day
+        save()
+        isSending = true
+        defer { isSending = false }
+        guard let (_, response) = try? await session.data(for: request),
+              let status = (response as? HTTPURLResponse)?.statusCode,
+              (200..<300).contains(status) else { return }
+
+        // A clock change may have added counts to a reported day during the request.
+        for report in reports {
+            let remaining = state.counts[report.day, default: 0] - report.count
+            state.counts[report.day] = remaining > 0 ? remaining : nil
+        }
+        save()
+    }
+
+    private static func day(at date: Date) -> Int {
+        Int((date.timeIntervalSince1970 / secondsPerDay).rounded(.down))
+    }
+
+    private func save() {
+        if let data = try? JSONEncoder().encode(state) {
+            defaults.set(data, forKey: Self.defaultsKey)
+        }
+    }
+}
+
+private final class NoRedirects: NSObject, URLSessionTaskDelegate {
+    func urlSession(_ session: URLSession, task: URLSessionTask,
+                    willPerformHTTPRedirection response: HTTPURLResponse, newRequest request: URLRequest,
+                    completionHandler: @escaping @Sendable (URLRequest?) -> Void) {
+        completionHandler(nil)
+    }
+}
