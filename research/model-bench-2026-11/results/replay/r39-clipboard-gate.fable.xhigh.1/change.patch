+++ b/scripts/tests/test-network-surface.sh
@@ -0,0 +1,286 @@
+#!/bin/bash
+# Holds the network gate to its own promise: the tree as it is passes, each
+# thing the gate exists to stop makes it fail, and a gate that cannot run one
+# of its checks fails instead of passing.
+#
+# The gate once lost the pattern for its clipboard check, printed "unbound
+# variable" and went on to say everything was fine. Nothing noticed, because
+# nothing ever asked the gate to fail. This does, for every check it has.
+#
+# Each case copies the shipping sources and the gate into a scratch tree,
+# plants lines there and runs the copied gate. The real tree is only read.
+
+set -euo pipefail
+
+REPOSITORY_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+WORK="$(mktemp -d)"
+TREE="$WORK/tree"
+trap 'rm -rf "$WORK"' EXIT
+
+CASES=0
+GATE_STATUS=0
+GATE_OUTPUT=""
+
+fail_test() {
+  printf 'FAIL: %s\n' "$1" >&2
+  printf '%s\n' "--- the gate said (exit $GATE_STATUS) ---" "$GATE_OUTPUT" >&2
+  exit 1
+}
+
+# A pristine copy of everything the gate reads, and of the gate itself.
+fresh_tree() {
+  rm -rf "$TREE"
+  mkdir -p "$TREE/scripts" "$TREE/Packages/DictationCore" "$TREE/Packages/LocalASR" "$TREE/apps/macos"
+  cp "$REPOSITORY_ROOT/scripts/check-network-surface.sh" "$TREE/scripts/"
+  cp -R "$REPOSITORY_ROOT/Packages/DictationCore/Sources" "$TREE/Packages/DictationCore/"
+  cp -R "$REPOSITORY_ROOT/Packages/LocalASR/Sources" "$TREE/Packages/LocalASR/"
+  cp -R "$REPOSITORY_ROOT/apps/macos/OpenRamble" "$TREE/apps/macos/"
+  cp "$REPOSITORY_ROOT/apps/macos/project.yml" "$TREE/apps/macos/"
+}
+
+# plant <new file in the tree> <line>...: writes the lines, one per line.
+plant() {
+  local file="$TREE/$1"
+  shift
+  mkdir -p "$(dirname "$file")"
+  printf '%s\n' "$@" > "$file"
+}
+
+run_gate() {
+  GATE_STATUS=0
+  GATE_OUTPUT=$("$TREE/scripts/check-network-surface.sh" 2>&1) || GATE_STATUS=$?
+}
+
+PASSED_LINE="Network source surface is limited to model downloads and update checks"
+
+# passes <what the tree holds>: runs the gate and expects a pass.
+passes() {
+  run_gate
+  [[ $GATE_STATUS -eq 0 ]] || fail_test "the gate refused $1"
+  [[ "$GATE_OUTPUT" == *"$PASSED_LINE"* ]] || fail_test "the gate exited 0 without saying it passed: $1"
+  CASES=$((CASES + 1))
+  printf '  passes  %s\n' "$1"
+}
+
+# refuses [explanation the report must carry]: runs the gate and expects a failure.
+refuses() {
+  run_gate
+  [[ $GATE_STATUS -ne 0 ]] || fail_test "the gate passed a tree it should have refused"
+  [[ "$GATE_OUTPUT" != *"$PASSED_LINE"* ]] || fail_test "the gate failed and still said it passed"
+  if [[ $# -gt 0 ]]; then
+    [[ "$GATE_OUTPUT" == *"$1"* ]] || fail_test "the gate failed without saying '$1'"
+  fi
+}
+
+# caught <what was planted> [text the report must contain]: after refuses.
+caught() {
+  if [[ $# -gt 1 ]]; then
+    [[ "$GATE_OUTPUT" == *"$2"* ]] || fail_test "the gate did not report $1"
+  fi
+  CASES=$((CASES + 1))
+  printf '  caught  %s\n' "$1"
+}
+
+NETWORK="VIOLATION: network outside permitted locations."
+CLIPBOARD="to Universal Clipboard"
+UPDATES="VIOLATION: Updates are not configured as promised to the user."
+LOGGING="VIOLATION: recognized text is included in the log."
+RUNTIME_SYMBOL="VIOLATION: the inference runtime references a network API."
+RUNTIME_LINK="VIOLATION: the inference runtime links a networking framework."
+
+PLANTED="apps/macos/OpenRamble/System/Planted.swift"
+
+echo "The tree as it is"
+fresh_tree
+passes "the shipping sources, untouched"
+
+echo "Clipboard"
+# Every way of emptying the clipboard without keeping it on this Mac, in each
+# of the three shipping places.
+CLIPBOARD_LINES=(
+  '        NSPasteboard.general.clearContents()'
+  '        pasteboard.clearContents ()'
+  '        pasteboard.declareTypes([.string], owner: nil)'
+  '        pasteboard.prepareForNewContents()'
+  '        pasteboard.prepareForNewContents(with: [])'
+  '        pasteboard.prepareForNewContents(with: .currentHostOnly); pasteboard.clearContents()'
+)
+IN_CORE="Packages/DictationCore/Sources/DictationCore/Planted.swift"
+IN_ASR="Packages/LocalASR/Sources/LocalASR/Planted.swift"
+# The two files that may use the network get no pass on the clipboard.
+IN_UPDATER="apps/macos/OpenRamble/System/SparkleUpdater.swift"
+fresh_tree
+plant "$PLANTED" "${CLIPBOARD_LINES[@]}"
+plant "$IN_CORE" "pasteboard.clearContents()"
+plant "$IN_ASR" "pasteboard.clearContents()"
+echo "func leak() { NSPasteboard.general.clearContents() }" >> "$TREE/$IN_UPDATER"
+refuses "$CLIPBOARD"
+number=0
+for line in "${CLIPBOARD_LINES[@]}"; do
+  number=$((number + 1))
+  caught "${line#        }" "  $PLANTED:$number:$line"
+done
+caught "clearContents() in DictationCore" "  $IN_CORE:1:"
+caught "clearContents() in LocalASR" "  $IN_ASR:1:"
+caught "clearContents() in a file that may use the network" "func leak() { NSPasteboard.general.clearContents() }"
+
+fresh_tree
+plant "$PLANTED" \
+  "        pasteboard.prepareForNewContents(with: .currentHostOnly)" \
+  "        // Never clearContents() here: it reaches Universal Clipboard." \
+  "    /// A plain \`clearContents()\` or declareTypes is prohibited." \
+  "    func clearContentsIfOwned() {}"
+plant "apps/macos/OpenRambleTests/Planted.swift" "        board.clearContents()"
+passes "the permitted call, comments that name clearContents(), and test code"
+
+echo "Network"
+# One line for every entry of the gate's denied list. Dropping an entry from
+# the gate, or fusing two with a lost '|', fails here.
+NETWORK_LINES=(
+  'let session = URLSession.shared'
+  'let connection = NWConnection(host: "example.com", port: 443, using: .tls)'
+  'let browser = NWBrowser(for: .bonjour(type: "_http._tcp", domain: nil), using: .tcp)'
+  'import CFNetwork'
+  'var stream: Unmanaged<CFStream>?'
+  'let view = WKWebView()'
+  'let service = NSNetService(domain: "", type: "_http._tcp", name: "")'
+  'let old = NSURLConnection()'
+  'let data = try Data(contentsOf: url)'
+  'let text = try String(contentsOf: url)'
+  'let rich = try NSAttributedString(url: url, options: [:], documentAttributes: nil)'
+  'let image = NSImage(contentsOf: url)'
+  'let asset = AVAsset(url: url)'
+  'let recognizer = SFSpeechRecognizer()'
+  'let store = NSUbiquitousKeyValueStore.default'
+  'let container = CKContainer.default()'
+  'let database: CKDatabase? = nil'
+  'MLModelCollection.beginAccessing(identifier: "models") { _ in }'
+)
+# The exemption is two exact paths, not two file names.
+SAME_NAME="apps/macos/OpenRamble/ModelDownloading.swift"
+fresh_tree
+plant "$PLANTED" "${NETWORK_LINES[@]}"
+plant "$SAME_NAME" "let session = URLSession.shared"
+refuses "$NETWORK"
+number=0
+for line in "${NETWORK_LINES[@]}"; do
+  number=$((number + 1))
+  caught "$line" "  $PLANTED:$number:$line"
+done
+caught "URLSession in another file named ModelDownloading.swift" "  $SAME_NAME:1:"
+
+fresh_tree
+echo "let extra = URLSession.shared" >> "$TREE/Packages/LocalASR/Sources/LocalASR/ModelDownloading.swift"
+echo "let other = URLSession.shared" >> "$TREE/$IN_UPDATER"
+plant "$PLANTED" "    // URLSession is not allowed in this file."
+passes "URLSession in the two files that may use the network, and in a comment"
+
+echo "Update settings"
+SETTINGS=("SUEnableAutomaticChecks: true" "SUSendProfileInfo: false" "SUAllowsAutomaticUpdates: false")
+for setting in "${SETTINGS[@]}"; do
+  grep -qF "$setting" "$REPOSITORY_ROOT/apps/macos/project.yml" \
+    || fail_test "project.yml has no '$setting' for this test to change"
+done
+
+fresh_tree
+sed -i '' \
+  -e 's/SUEnableAutomaticChecks: true/SUEnableAutomaticChecks: false/' \
+  -e 's/SUSendProfileInfo: false/SUSendProfileInfo: true/' \
+  -e 's/SUAllowsAutomaticUpdates: false/SUAllowsAutomaticUpdates: true/' \
+  "$TREE/apps/macos/project.yml"
+refuses "$UPDATES"
+for setting in "${SETTINGS[@]}"; do
+  caught "${setting%%:*} set the other way" "does not have the line '$setting'"
+done
+
+fresh_tree
+sed -i '' -e '/SUEnableAutomaticChecks/d' -e '/SUSendProfileInfo/d' -e '/SUAllowsAutomaticUpdates/d' \
+  "$TREE/apps/macos/project.yml"
+refuses "$UPDATES"
+for setting in "${SETTINGS[@]}"; do
+  caught "${setting%%:*} removed" "does not have the line '$setting'"
+done
+
+echo "Dictated text in the log"
+LOGGING_LINES=(
+  '        logger.info("heard \(transcript)")'
+  '        log.debug("\(recognizedText)")'
+  '        logger.error("failed after \(dictatedText)")'
+)
+fresh_tree
+plant "$PLANTED" "${LOGGING_LINES[@]}"
+refuses "$LOGGING"
+number=0
+for line in "${LOGGING_LINES[@]}"; do
+  number=$((number + 1))
+  caught "${line#        }" "  $PLANTED:$number:$line"
+done
+
+echo "Two kinds at once"
+fresh_tree
+plant "$PLANTED" "let session = URLSession.shared" "NSPasteboard.general.clearContents()"
+refuses "$NETWORK"
+[[ "$GATE_OUTPUT" == *"$CLIPBOARD"* ]] || fail_test "the clipboard finding was filed under the network heading"
+caught "URLSession and clearContents(), each under its own explanation"
+
+echo "Inference runtime"
+# A stand-in for the prebuilt runtime: a real Mach-O at the path the gate looks
+# for, built here so the audit has something to read without a package build.
+RUNTIME="Packages/LocalASR/.build/artifacts/CTranscribe.framework/Versions/A/CTranscribe"
+build_runtime() {  # build_runtime <C source> [linker flags]
+  local source="$1"
+  shift
+  mkdir -p "$(dirname "$TREE/$RUNTIME")"
+  printf '%s\n' "$source" > "$WORK/runtime.c"
+  clang -dynamiclib -o "$TREE/$RUNTIME" "$WORK/runtime.c" "$@" 2> "$WORK/clang.log" \
+    || fail_test "could not build a stand-in runtime: $(cat "$WORK/clang.log")"
+}
+
+fresh_tree
+passes "no runtime built yet"
+[[ "$GATE_OUTPUT" != *"cannot reach the network"* && "$GATE_OUTPUT" == *"was not audited"* ]] \
+  || fail_test "the gate vouched for a runtime it did not audit"
+
+fresh_tree
+build_runtime 'int transcribe(void) { return 0; }'
+passes "a runtime with no network reference"
+[[ "$GATE_OUTPUT" == *"the inference runtime cannot reach the network at all"* ]] \
+  || fail_test "the gate audited a clean runtime and did not say so"
+
+fresh_tree
+build_runtime '#include <sys/socket.h>
+int transcribe(void) { return socket(AF_INET, SOCK_STREAM, 0); }'
+refuses "$RUNTIME_SYMBOL"
+caught "a runtime that calls socket()" "_socket"
+
+fresh_tree
+build_runtime 'int transcribe(void) { return 0; }' -framework CFNetwork
+refuses "$RUNTIME_LINK"
+caught "a runtime that links CFNetwork" "CFNetwork.framework"
+
+echo "A gate that cannot run a check"
+fresh_tree
+mkdir -p "$(dirname "$TREE/$RUNTIME")"
+echo "not a Mach-O" > "$TREE/$RUNTIME"
+refuses "GATE BROKEN"
+caught "a runtime the audit cannot read"
+
+fresh_tree
+mv "$TREE/apps/macos/OpenRamble" "$TREE/apps/macos/Renamed"
+refuses "GATE BROKEN"
+caught "a shipping directory that is not where the gate looks"
+
+# The incident itself: the clipboard pattern is gone from the gate.
+fresh_tree
+grep -q '^FORBIDDEN_PASTEBOARD=' "$TREE/scripts/check-network-surface.sh" \
+  || fail_test "the gate does not define FORBIDDEN_PASTEBOARD"
+sed -i '' '/^FORBIDDEN_PASTEBOARD=/d' "$TREE/scripts/check-network-surface.sh"
+refuses "FORBIDDEN_PASTEBOARD: unbound variable"
+caught "a gate whose clipboard pattern is missing"
+
+fresh_tree
+sed -i '' "s/^FORBIDDEN_PASTEBOARD=.*/FORBIDDEN_PASTEBOARD=''/" "$TREE/scripts/check-network-surface.sh"
+refuses "GATE BROKEN"
