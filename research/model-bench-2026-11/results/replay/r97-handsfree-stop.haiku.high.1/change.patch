+/// A paste that holds until the test opens its gate, so the controller stays
+/// in `.inserting` for as long as the test needs.
+actor GatedInserter: TextInserting {
+    private let gate: Gate
+    private(set) var insertedTexts: [String] = []
+
+    init(gate: Gate) { self.gate = gate }
+
+    func insert(_ text: String, into target: TargetApplication?) async throws {
+        await gate.pass()
+        insertedTexts.append(text)
+    }
+    func pressReturn() async throws {}
+    nonisolated func frontmostApplication() -> TargetApplication? { nil }
+}
