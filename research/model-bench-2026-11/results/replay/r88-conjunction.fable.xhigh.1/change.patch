+    /// A joining word leads into what comes next, so the words before it can
+    /// close one phrase and the same words open the next. Every word here was
+    /// meant: only the hesitation goes, with spoken corrections on and off.
+    func testWordsSaidAgainAfterAJoiningWordAreKept() {
+        let cases = [
+            ("We shipped it and, um, it works.", "We shipped it and it works."),
+            ("I'll ask Sam and, uh, Sam will know.", "I'll ask Sam and Sam will know."),
+            ("Ship it if, um, it passes review.", "Ship it if it passes review."),
+            ("I told you that, um, you should come.", "I told you that you should come."),
+            ("We talked to them about, um, them joining.", "We talked to them about them joining."),
+            ("Мы сделали это и, э, это работает.", "Мы сделали это и это работает."),
+            // No commas around the hesitation, and other joining words.
+            ("We shipped it and uh it works.", "We shipped it and it works."),
+            ("I called her but, um, her phone was off.", "I called her but her phone was off."),
+            ("Send it when, uh, it is ready.", "Send it when it is ready."),
+            ("I like it because, um, it works.", "I like it because it works."),
+            ("Leave it or, um, it breaks.", "Leave it or it breaks."),
+            ("I'll send it to Sam for, uh, Sam to review.", "I'll send it to Sam for Sam to review."),
+            ("Я сказал ему что, э, ему надо прийти.", "Я сказал ему что ему надо прийти."),
+            ("Я позвал её но, ээ, её не было.", "Я позвал её но её не было."),
+            // Two words said again.
+            ("We shipped the build and, um, the build works.", "We shipped the build and the build works."),
+            ("I'll help if I can and, um, I can also drive.", "I'll help if I can and I can also drive."),
+            ("Ship the fix if, um, the fix passes review.", "Ship the fix if the fix passes review."),
+            ("I do what I want when, um, I want it.", "I do what I want when I want it."),
+            ("We talked to people about, um, people in tech.", "We talked to people about people in tech."),
+            ("For you if, um, you want it.", "For you if you want it."),
+            ("I asked Dr. Lee if, uh, Lee could come.", "I asked Dr. Lee if Lee could come."),
+            // After "and", "or", "but", "so" and "then" the same words can open
+            // the next part even where the sentence starts.
+            ("We tried and, um, we tried again.", "We tried and we tried again."),
+            ("The build and, um, the build server are down.", "The build and the build server are down."),
+            ("I think so, um, I think we should wait.", "I think so I think we should wait."),
+            ("Мы ждали и, э, мы ждали долго.", "Мы ждали и мы ждали долго."),
+        ]
+        for (input, expected) in cases {
+            for spokenCorrections in [true, false] {
+                let cleaned = CleanVerbatim.clean(input, spokenCorrections: spokenCorrections)
+                XCTAssertEqual(cleaned, expected, "\(input) (spoken corrections: \(spokenCorrections))")
+                XCTAssertEqual(
+                    CleanVerbatim.clean(cleaned, spokenCorrections: spokenCorrections), expected, "idempotent: \(input)"
+                )
+            }
+        }
+    }
+
+    /// A phrase that stops on a joining word is still a restart where its
+    /// first copy opens the sentence or follows a comma, alone or after an
+    /// opening "So".
+    func testARestartThatStopsOnAJoiningWordStillCollapses() {
+        let cases = [
+            ("I think that, um, I think we should wait.", "I think we should wait."),
+            ("Okay, I think that, um, I think we should wait.", "Okay, I think we should wait."),
+            ("Let's meet at, uh, let's meet on Monday.", "Let's meet on Monday."),
+            ("So I think that, um, I think we should wait.", "So I think we should wait."),
+            ("And then I think that, um, I think we should wait.", "And then I think we should wait."),
+            ("If that fails, I think that, um, I think we should wait.", "If that fails, I think we should wait."),
+            ("Note: I think that, um, I think we should wait.", "Note: I think we should wait."),
+            ("It ships. Let's meet at, uh, let's meet on Monday.", "It ships. Let's meet on Monday."),
+            ("It's about, um, it's around five.", "It's around five."),
+            ("Я думаю что, э, я думаю надо подождать.", "Я думаю надо подождать."),
+            ("Мы пойдём в, э, мы пойдём на пляж.", "Мы пойдём на пляж."),
+        ]
+        for (input, expected) in cases {
+            for spokenCorrections in [true, false] {
+                XCTAssertEqual(
+                    CleanVerbatim.clean(input, spokenCorrections: spokenCorrections), expected,
+                    "\(input) (spoken corrections: \(spokenCorrections))"
+                )
+            }
+        }
+    }
