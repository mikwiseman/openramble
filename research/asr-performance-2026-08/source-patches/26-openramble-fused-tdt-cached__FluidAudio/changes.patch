+    /// Produce a checked conservative byte span for alias detection. Negative strides and all
+    /// arithmetic overflow fail closed because they cannot support a replay-safety proof.
+    private func memoryRegion(
+        for array: MLMultiArray,
+        name: String
+    ) throws -> TdtCachedFusionMemoryRegion {
+        let elementByteCount: Int
+        switch array.dataType {
+        case .double:
+            elementByteCount = MemoryLayout<Double>.size
+        case .float32:
+            elementByteCount = MemoryLayout<Float>.size
+        case .float16:
+            elementByteCount = MemoryLayout<UInt16>.size
+        case .int32:
+            elementByteCount = MemoryLayout<Int32>.size
+        case .int8:
+            elementByteCount = MemoryLayout<Int8>.size
+        @unknown default:
+            throw ASRError.processingFailed(
+                "Cached fused alias analysis does not support dtype \(array.dataType.rawValue)"
+            )
+        }
+
+        let shape = array.shape.map(\.intValue)
+        let strides = array.strides.map(\.intValue)
+        guard shape.count == strides.count, !shape.isEmpty else {
+            throw ASRError.processingFailed(
+                "Cached fused alias analysis found invalid rank for \(name)"
+            )
+        }
+
+        var maximumElementOffset = 0
+        for (dimension, stride) in zip(shape, strides) {
+            guard dimension > 0, stride >= 0 else {
+                throw ASRError.processingFailed(
+                    "Cached fused alias analysis found unsupported layout for \(name)"
+                )
+            }
+            let (dimensionOffset, productOverflow) = (dimension - 1).multipliedReportingOverflow(
+                by: stride)
+            let (nextMaximum, sumOverflow) = maximumElementOffset.addingReportingOverflow(
+                dimensionOffset)
+            guard !productOverflow, !sumOverflow else {
+                throw ASRError.processingFailed(
+                    "Cached fused alias analysis overflowed for \(name)"
+                )
+            }
+            maximumElementOffset = nextMaximum
+        }
+
+        let (spanElements, spanOverflow) = maximumElementOffset.addingReportingOverflow(1)
+        let (byteCount, byteOverflow) = spanElements.multipliedReportingOverflow(by: elementByteCount)
+        guard !spanOverflow, !byteOverflow, byteCount > 0 else {
+            throw ASRError.processingFailed(
+                "Cached fused alias analysis found invalid span for \(name)"
+            )
+        }
+
+        let lowerBound = UInt(bitPattern: Int(bitPattern: array.dataPointer))
+        let (upperBound, pointerOverflow) = lowerBound.addingReportingOverflow(UInt(byteCount))
+        guard !pointerOverflow else {
+            throw ASRError.processingFailed(
+                "Cached fused alias analysis pointer overflowed for \(name)"
+            )
+        }
+        return TdtCachedFusionMemoryRegion(
+            name: name,
+            lowerBound: lowerBound,
+            upperBound: upperBound
+        )
+    }
