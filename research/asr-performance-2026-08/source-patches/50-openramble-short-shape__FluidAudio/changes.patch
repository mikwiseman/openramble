+// TEMP-ONLY benchmark instrumentation. This fork exists only under $TMP.
+private actor TempASRWindowCounter {
+    static let shared = TempASRWindowCounter()
+    private var count = 0
+    private var layouts: [TempASRWindowLayout] = []
+
+    func reset() {
+        count = 0
+        layouts = []
+    }
+    func increment() { count += 1 }
+    func value() -> Int { count }
+    func append(_ layout: TempASRWindowLayout) { layouts.append(layout) }
+    func layoutValues() -> [TempASRWindowLayout] { layouts }
+}
+
+public struct TempASRWindowLayout: Codable, Hashable, Sendable {
+    public let index: Int
+    public let inputStartSample: Int
+    public let visibleStartSample: Int
+    public let visibleEndSample: Int
+    public let contextSamples: Int
+    public let isLast: Bool
+
+    public init(
+        index: Int,
+        inputStartSample: Int,
+        visibleStartSample: Int,
+        visibleEndSample: Int,
+        contextSamples: Int,
+        isLast: Bool
+    ) {
+        self.index = index
+        self.inputStartSample = inputStartSample
+        self.visibleStartSample = visibleStartSample
+        self.visibleEndSample = visibleEndSample
+        self.contextSamples = contextSamples
+        self.isLast = isLast
+    }
+}
+
+internal func recordTempASREncoderWindow() async {
+    guard ProcessInfo.processInfo.environment["OPENRAMBLE_TEMP_WINDOW_DIAGNOSTICS"] == "1" else {
+        return
+    }
+    await TempASRWindowCounter.shared.increment()
+}
+
+internal func recordTempASRWindowLayout(_ layout: TempASRWindowLayout) async {
+    guard ProcessInfo.processInfo.environment["OPENRAMBLE_TEMP_WINDOW_DIAGNOSTICS"] == "1" else {
+        return
+    }
+    await TempASRWindowCounter.shared.append(layout)
+}
+
+public func resetTempASREncoderWindowCount() async {
+    await TempASRWindowCounter.shared.reset()
+}
+
+public func tempASREncoderWindowCount() async -> Int {
+    await TempASRWindowCounter.shared.value()
+}
+
+public func tempASRWindowLayouts() async -> [TempASRWindowLayout] {
+    await TempASRWindowCounter.shared.layoutValues()
+}
