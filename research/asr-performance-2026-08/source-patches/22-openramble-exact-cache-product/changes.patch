+    func samples(in range: Range<Int>) throws -> [Float] {
+        guard range.lowerBound >= 0, range.upperBound <= sampleCount else {
+            throw RecordingPCMRangeSnapshotError.invalidRange
+        }
+        guard !range.isEmpty else { return [] }
+
+        var matchingChunks: [RecordingPCMChunk] = []
+        var cursor = head
+        while let chunk = cursor {
+            let chunkEnd = chunk.startSample + chunk.samples.count
+            if chunk.startSample < range.upperBound, chunkEnd > range.lowerBound {
+                matchingChunks.append(chunk)
