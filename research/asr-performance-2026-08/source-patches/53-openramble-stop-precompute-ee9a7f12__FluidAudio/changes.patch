+    /// Reconstruct the exact window plan without running Core ML.
+    ///
+    /// Temporary research seam used by the `$TMP` closed-window cache.
+    /// The conservative stability bound covers the complete ±4-second silence
+    /// search and the 80ms energy half-window. The shipping v3/no-mel path has
+    /// no warmup-prefix probe, so no farther future samples are consulted.
+    func tempWindowPlans(
+        melChunkContext: Bool,
+        modelVersion: AsrModelVersion?
+    ) throws -> [TempChunkWindowPlan] {
+        let layout = chunkLayout(melChunkContext: melChunkContext, modelVersion: modelVersion)
+        let decisions = try chunkStarts(
+            warmupPrefixSamples: layout.warmupPrefixSamples,
+            chunkSamples: layout.chunkSamples,
+            strideSamples: layout.strideSamples,
+            preferSilenceAlignment: !melChunkContext && modelVersion == .v3
+        )
+        let frameSamples = ASRConstants.samplesPerEncoderFrame
+        let searchRadiusFrames = max(
+            1,
+            Int((4.0 * Double(ASRConstants.sampleRate)) / Double(frameSamples))
+        )
+        var plans: [TempChunkWindowPlan] = []
+        var stableThroughSampleCount = 0
+
+        for (index, decision) in decisions.enumerated() {
+            let warmupSamples =
+                index > 0 && decision.useWarmupPrefix
+                ? min(layout.warmupPrefixSamples, decision.start) : 0
+            let visibleChunkSamples = max(
+                ASRConstants.samplesPerEncoderFrame,
+                layout.chunkSamples - warmupSamples
+            )
+            let candidateEnd = decision.start + visibleChunkSamples
+            let isLastChunk = candidateEnd >= totalSamples
+            let chunkEnd = isLastChunk ? totalSamples : candidateEnd
+            guard chunkEnd > decision.start else { break }
+
+            let contextSamples = warmupSamples > 0 ? 0 : (index > 0 ? layout.melContextSamples : 0)
+            let contextStart = decision.start - max(warmupSamples, contextSamples)
+            let emitTokensAfterFrame =
+                warmupSamples > 0 ? decision.start / ASRConstants.samplesPerEncoderFrame : nil
+
+            if index > 0, !melChunkContext, modelVersion == .v3 {
+                let target = index * layout.strideSamples
+                let targetFrame = target / frameSamples
+                let fullSearchSampleCount =
+                    (targetFrame + searchRadiusFrames) * frameSamples + frameSamples
+                stableThroughSampleCount = max(stableThroughSampleCount, fullSearchSampleCount)
+            }
+
+            plans.append(
+                TempChunkWindowPlan(
+                    index: index,
+                    chunkStart: decision.start,
+                    contextStart: contextStart,
+                    chunkEnd: chunkEnd,
+                    contextSamples: contextSamples,
+                    chunkStartOffset: warmupSamples > 0 ? contextStart : decision.start,
+                    isLastChunk: isLastChunk,
+                    emitTokensAfterFrame: emitTokensAfterFrame,
+                    initialTimeIndexOverride: emitTokensAfterFrame == nil ? nil : 0,
+                    stableStartPrefixSampleCount: stableThroughSampleCount,
+                    earliestSafePrefixSampleCount: max(
+                        ASRConstants.maxModelSamples + 1,
+                        stableThroughSampleCount,
+                        candidateEnd + 1
+                    )
+                )
+            )
+            if isLastChunk { break }
+        }
+        return plans
+    }
