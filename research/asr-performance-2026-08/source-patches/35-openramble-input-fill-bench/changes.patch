+    func testPreparePreprocessorInputPadsDirectlyIntoCachedArray() async throws {
+        await sharedMLArrayCache.clear()
+
+        let dirtyInput = try await manager.preparePreprocessorInput(
+            Array(repeating: 9, count: 8),
+            paddedTo: 8
+        )
+        let dirtyArray = try XCTUnwrap(
+            dirtyInput.featureValue(for: "audio_signal")?.multiArrayValue
+        )
+        await sharedMLArrayCache.returnArray(dirtyArray, resetData: false)
+
+        let input = try await manager.preparePreprocessorInput(
+            [0.25, -0.5, 0.75],
+            actualLength: 4,
+            paddedTo: 8
+        )
+        let signal = try XCTUnwrap(
+            input.featureValue(for: "audio_signal")?.multiArrayValue
+        )
+        XCTAssertEqual(signal.shape, [1, 8] as [NSNumber])
+        XCTAssertEqual(signal[0].floatValue, 0.25, accuracy: 0.0001)
+        XCTAssertEqual(signal[1].floatValue, -0.5, accuracy: 0.0001)
+        XCTAssertEqual(signal[2].floatValue, 0.75, accuracy: 0.0001)
+        for index in 3..<8 {
