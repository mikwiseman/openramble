.build-zero-network/
.build-tools/

# The resolved versions file is not intentionally tracked.
#
# It fluctuates on its own: xcodebuild adds Sparkle from the graph there
# applications, swift build for one package removes it. Everyone who collects
# project in both ways - and this is the usual procedure - the tree turns out to be
# dirty, and in general work these are conflicts from scratch.
#
# Nothing to lose: both dependencies are fixed by the exact version in the manifests themselves
# (FluidAudio - exact in Package.swift, Sparkle - exactVersion in project.yml),
# and FluidAudio does not have its own dependencies at all.
Package.resolved
.gstack/

# Rust workspace
/target/
# Fixture generator build products — the fixtures themselves are committed.
core/conformance/generator/.build/
# Tauri build products
apps/desktop/src-tauri/gen/
