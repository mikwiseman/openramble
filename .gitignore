# Модель скачивается пользователем, в репозитории её нет
Models/
*.mlmodelc

# Временные файлы проверки без сети
.build-zero-network/

# Файл разрешённых версий не отслеживается намеренно.
#
# Он колеблется сам по себе: xcodebuild дописывает туда Sparkle из графа
# приложения, swift build для одного пакета её убирает. У каждого, кто соберёт
# проект обоими способами — а это обычный порядок работы, — дерево оказывается
# грязным, и в общей работе это конфликты на пустом месте.
#
# Терять нечего: обе зависимости закреплены точной версией в самих манифестах
# (FluidAudio — exact в Package.swift, Sparkle — exactVersion в project.yml),
# а своих зависимостей у FluidAudio нет вовсе.
Package.resolved
